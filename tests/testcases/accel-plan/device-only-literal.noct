__accel func transform(
    source: rpackedint32,
    destination: rpackedint32,
    n: int): void {
    let temporary: packedint32 = Packed.int32(5);
    for (i in 0..5) {
        temporary[i] = source[i] * 3;
    }
    for (j in 0..5) {
        destination[j] = temporary[j] + 1;
    }
}

func main() {
}
