// Packed load/store loops; at -O2 the ABCE pass turns
// these accesses into raw OP_PLOAD8U/OP_PSTORE8 pointer operations.
func main() {
    var n = 300;
    var p = Packed.uint8(n);
    for (i in 0..n) {
        p[i] = 255 - (i % 256);
    }
    for (i in 0..n) {
        p[i] = (p[i] + i) % 256;
    }
    var sum = 0;
    for (i in 0..n) {
        sum = sum + p[i];
    }
    print(sum);
}
