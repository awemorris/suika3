__gpu func cifar_gpu_max_pool2x2(
    input: rpackedfloat_ptr, output: rpackedfloat_ptr,
    channels: int, input_size: int, output_size: int, count: int
): void {
    let i: int = globalIdx.x;
    if (i < count) {
        let channel: int = i / (output_size * output_size);
        let spatial: int = i % (output_size * output_size);
        let y: int = spatial / output_size;
        let x: int = spatial % output_size;
        let input_base: int = channel * input_size * input_size +
            y * 2 * input_size + x * 2;
        output[i] = input[input_base];
        if (input[input_base + 1] > output[i]) {
            output[i] = input[input_base + 1];
        }
        if (input[input_base + input_size] > output[i]) {
            output[i] = input[input_base + input_size];
        }
        if (input[input_base + input_size + 1] > output[i]) {
            output[i] = input[input_base + input_size + 1];
        }
    }
}

