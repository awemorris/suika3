            + input[15] * weight[base + 15]
            + input[16] * weight[base + 16]
            + input[17] * weight[base + 17]
            + input[18] * weight[base + 18]
            + input[19] * weight[base + 19]
            + input[20] * weight[base + 20]
            + input[21] * weight[base + 21]
            + input[22] * weight[base + 22]
            + input[23] * weight[base + 23]
            ;
        output[i] = output[i]
            + input[24] * weight[base + 24]
            + input[25] * weight[base + 25]
            + input[26] * weight[base + 26]
            + input[27] * weight[base + 27]
            + input[28] * weight[base + 28]
            + input[29] * weight[base + 29]
            + input[30] * weight[base + 30]
            + input[31] * weight[base + 31]
            + input[32] * weight[base + 32]
            + input[33] * weight[base + 33]
            + input[34] * weight[base + 34]
            + input[35] * weight[base + 35]
            + input[36] * weight[base + 36]
            + input[37] * weight[base + 37]
            + input[38] * weight[base + 38]
            + input[39] * weight[base + 39]
            + input[40] * weight[base + 40]
            + input[41] * weight[base + 41]
            + input[42] * weight[base + 42]
            + input[43] * weight[base + 43]
            + input[44] * weight[base + 44]
            + input[45] * weight[base + 45]
            + input[46] * weight[base + 46]
            + input[47] * weight[base + 47]
            ;
        output[i] = output[i]
            + input[48] * weight[base + 48]
            + input[49] * weight[base + 49]
            + input[50] * weight[base + 50]
            + input[51] * weight[base + 51]
            + input[52] * weight[base + 52]
            + input[53] * weight[base + 53]
            + input[54] * weight[base + 54]
            + input[55] * weight[base + 55]
            + input[56] * weight[base + 56]
            + input[57] * weight[base + 57]
            + input[58] * weight[base + 58]
            + input[59] * weight[base + 59]
            + input[60] * weight[base + 60]
            + input[61] * weight[base + 61]
            + input[62] * weight[base + 62]
            + input[63] * weight[base + 63]
            + input[64] * weight[base + 64]
            + input[65] * weight[base + 65]
            + input[66] * weight[base + 66]
            + input[67] * weight[base + 67]
            + input[68] * weight[base + 68]
            + input[69] * weight[base + 69]
            + input[70] * weight[base + 70]
            + input[71] * weight[base + 71]
            ;
        output[i] = output[i]
            + input[72] * weight[base + 72]
            + input[73] * weight[base + 73]
            + input[74] * weight[base + 74]
            + input[75] * weight[base + 75]
            + input[76] * weight[base + 76]
            + input[77] * weight[base + 77]
            + input[78] * weight[base + 78]
            + input[79] * weight[base + 79]
            + input[80] * weight[base + 80]
            + input[81] * weight[base + 81]
            + input[82] * weight[base + 82]
            + input[83] * weight[base + 83]
            ;
    }
}

func cifar_setup() {
    for (i in 0..3072) {
        cifar_host_input[i] = 1.0;
    }
    for (i in 0..6) {
        cifar_host_conv1_w[i * 75 + 12] = 1.0;
    }
    for (i in 0..16) {
        cifar_host_conv2_w[i * 150 + 12] = 1.0;
    }
    for (i in 0..120) {
        cifar_host_fc1_w[i * 400] = 1.0;
    }
    for (i in 0..84) {
        cifar_host_fc2_w[i * 120] = 1.0;
    }
    for (i in 0..10) {
        cifar_host_fc3_w[i * 84] = 1.0;
    }
    cifar_host_fc3_b[0] = 0.0;
    cifar_host_fc3_b[1] = 1.0;
    cifar_host_fc3_b[2] = 2.0;
    cifar_host_fc3_b[3] = 3.0;
    cifar_host_fc3_b[4] = 4.0;
    cifar_host_fc3_b[5] = 5.0;
    cifar_host_fc3_b[6] = 6.0;
    cifar_host_fc3_b[7] = 7.0;
    cifar_host_fc3_b[8] = 8.0;
    cifar_host_fc3_b[9] = 9.0;

    Accel.copyToAccel(cifar_host_input, 0, cifar_input, 0, 12288);
    Accel.copyToAccel(cifar_host_conv1_w, 0, cifar_conv1_w, 0, 1800);
    Accel.copyToAccel(cifar_host_conv1_b, 0, cifar_conv1_b, 0, 24);
    Accel.copyToAccel(cifar_host_conv2_w, 0, cifar_conv2_w, 0, 9600);
    Accel.copyToAccel(cifar_host_conv2_b, 0, cifar_conv2_b, 0, 64);
    Accel.copyToAccel(cifar_host_fc1_w, 0, cifar_fc1_w, 0, 192000);
    Accel.copyToAccel(cifar_host_fc1_b, 0, cifar_fc1_b, 0, 480);
    Accel.copyToAccel(cifar_host_fc2_w, 0, cifar_fc2_w, 0, 40320);
    Accel.copyToAccel(cifar_host_fc2_b, 0, cifar_fc2_b, 0, 336);
    Accel.copyToAccel(cifar_host_fc3_w, 0, cifar_fc3_w, 0, 3360);
    Accel.copyToAccel(cifar_host_fc3_b, 0, cifar_fc3_b, 0, 40);
}

func cifar_cpu_forward(iterations: int) {
    for (iteration in 0..iterations) {
        cifar_cpu_conv_relu(cifar_host_input, cifar_host_conv1_w,
            cifar_host_conv1_b, cifar_host_conv1, 3, 32, 6, 28);
        cifar_cpu_max_pool2x2(cifar_host_conv1, cifar_host_pool1,
            6, 28, 14);
        cifar_cpu_conv_relu(cifar_host_pool1, cifar_host_conv2_w,
            cifar_host_conv2_b, cifar_host_conv2, 6, 14, 16, 10);
        cifar_cpu_max_pool2x2(cifar_host_conv2, cifar_host_pool2,
            16, 10, 5);
        cifar_cpu_dense(cifar_host_pool2, cifar_host_fc1_w,
            cifar_host_fc1_b, cifar_host_fc1, 400, 120, 1);
        cifar_cpu_dense(cifar_host_fc1, cifar_host_fc2_w,
            cifar_host_fc2_b, cifar_host_fc2, 120, 84, 1);
        cifar_cpu_dense(cifar_host_fc2, cifar_host_fc3_w,
            cifar_host_fc3_b, cifar_host_logits, 84, 10, 0);
    }
}

func cifar_gpu_forward(iterations: int) {
    for (iteration in 0..iterations) {
        cifar_gpu_conv1_relu<<<37, 128>>>(
            cifar_input, cifar_conv1_w, cifar_conv1_b, cifar_conv1, 4704);
        cifar_gpu_max_pool2x2<<<10, 128>>>(
            cifar_conv1, cifar_pool1, 6, 28, 14, 1176);
        cifar_gpu_conv2_relu<<<13, 128>>>(
            cifar_pool1, cifar_conv2_w, cifar_conv2_b, cifar_conv2, 1600);
        cifar_gpu_max_pool2x2<<<4, 128>>>(
            cifar_conv2, cifar_pool2, 16, 10, 5, 400);
        cifar_gpu_fc1_relu<<<1, 128>>>(
            cifar_pool2, cifar_fc1_w, cifar_fc1_b, cifar_fc1, 120);
        cifar_gpu_fc2_relu<<<1, 128>>>(
            cifar_fc1, cifar_fc2_w, cifar_fc2_b, cifar_fc2, 84);
        cifar_gpu_fc3<<<1, 128>>>(
            cifar_fc2, cifar_fc3_w, cifar_fc3_b, cifar_logits, 10);
    }
}

func cifar_verify_cpu() {
    if (cifar_host_logits[0] != 1.0) {
        return 0;
    }
    if (cifar_host_logits[1] != 2.0) {
        return 0;
    }
    if (cifar_host_logits[2] != 3.0) {
        return 0;
    }
    if (cifar_host_logits[3] != 4.0) {
        return 0;
    }
    if (cifar_host_logits[4] != 5.0) {
        return 0;
    }
    if (cifar_host_logits[5] != 6.0) {
        return 0;
    }
    if (cifar_host_logits[6] != 7.0) {
        return 0;
    }
    if (cifar_host_logits[7] != 8.0) {
        return 0;
    }
    if (cifar_host_logits[8] != 9.0) {
        return 0;
    }
    if (cifar_host_logits[9] != 10.0) {
        return 0;
    }
    return 1;
}

func cifar_verify_gpu() {
    Accel.copyFromAccel(cifar_logits, 0, cifar_host_logits, 0, 40);
    if (cifar_host_logits[0] != 1.0) {
        return 0;
    }
    if (cifar_host_logits[1] != 2.0) {
        return 0;
    }
    if (cifar_host_logits[2] != 3.0) {
        return 0;
    }
    if (cifar_host_logits[3] != 4.0) {
        return 0;
    }
    if (cifar_host_logits[4] != 5.0) {
        return 0;
    }
    if (cifar_host_logits[5] != 6.0) {
        return 0;
    }
    if (cifar_host_logits[6] != 7.0) {
        return 0;
    }
    if (cifar_host_logits[7] != 8.0) {
        return 0;
    }
    if (cifar_host_logits[8] != 9.0) {
        return 0;
    }
    if (cifar_host_logits[9] != 10.0) {
        return 0;
    }
    return 1;
}

func main() {
    cifar_setup();
    cifar_cpu_forward(1);
    cifar_gpu_forward(1);
    if (cifar_verify_cpu() != 1 || cifar_verify_gpu() != 1) {
        print("CIFAR-10 CNN verification failed");
        return;
    }
    print(cifar_host_logits[0]);
    print(cifar_host_logits[1]);
    print(cifar_host_logits[2]);
    print(cifar_host_logits[3]);
    print(cifar_host_logits[4]);
    print(cifar_host_logits[5]);
    print(cifar_host_logits[6]);
    print(cifar_host_logits[7]);
    print(cifar_host_logits[8]);
    print(cifar_host_logits[9]);
}
