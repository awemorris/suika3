// CIFAR-10 forward benchmark based on the network in the official PyTorch tutorial:
// https://docs.pytorch.org/tutorials/beginner/blitz/cifar10_tutorial.html
//
// The topology is Conv5x5(3->6) -> ReLU -> MaxPool2x2 ->
// Conv5x5(6->16) -> ReLU -> MaxPool2x2 -> 400->120->84->10.
// Fixed dot products are expanded because the current raw __gpu func subset
// intentionally has no source-level loop statement.

__accel var cifar_input = Accel.float32(3072);
__accel var cifar_conv1_w = Accel.float32(450);
__accel var cifar_conv1_b = Accel.float32(6);
__accel var cifar_conv1 = Accel.float32(4704);
__accel var cifar_pool1 = Accel.float32(1176);
__accel var cifar_conv2_w = Accel.float32(2400);
__accel var cifar_conv2_b = Accel.float32(16);
__accel var cifar_conv2 = Accel.float32(1600);
__accel var cifar_pool2 = Accel.float32(400);
__accel var cifar_fc1_w = Accel.float32(48000);
__accel var cifar_fc1_b = Accel.float32(120);
__accel var cifar_fc1 = Accel.float32(120);
__accel var cifar_fc2_w = Accel.float32(10080);
__accel var cifar_fc2_b = Accel.float32(84);
__accel var cifar_fc2 = Accel.float32(84);
__accel var cifar_fc3_w = Accel.float32(840);
__accel var cifar_fc3_b = Accel.float32(10);
__accel var cifar_logits = Accel.float32(10);

var cifar_host_input = Packed.float32(3072);
var cifar_host_conv1_w = Packed.float32(450);
var cifar_host_conv1_b = Packed.float32(6);
var cifar_host_conv1 = Packed.float32(4704);
var cifar_host_pool1 = Packed.float32(1176);
var cifar_host_conv2_w = Packed.float32(2400);
var cifar_host_conv2_b = Packed.float32(16);
var cifar_host_conv2 = Packed.float32(1600);
var cifar_host_pool2 = Packed.float32(400);
var cifar_host_fc1_w = Packed.float32(48000);
var cifar_host_fc1_b = Packed.float32(120);
var cifar_host_fc1 = Packed.float32(120);
var cifar_host_fc2_w = Packed.float32(10080);
var cifar_host_fc2_b = Packed.float32(84);
var cifar_host_fc2 = Packed.float32(84);
var cifar_host_fc3_w = Packed.float32(840);
var cifar_host_fc3_b = Packed.float32(10);
var cifar_host_logits = Packed.float32(10);

func cifar_cpu_conv_relu(
    input: rpackedfloat, weight: rpackedfloat, bias: rpackedfloat,
    output: rpackedfloat, input_channels: int, input_size: int,
    output_channels: int, output_size: int) {
    for (i in 0..output_channels * output_size * output_size) {
        let channel: int = i / (output_size * output_size);
        let spatial: int = i % (output_size * output_size);
        let y: int = spatial / output_size;
        let x: int = spatial % output_size;
        var sum: float = bias[channel];
        for (input_channel in 0..input_channels) {
            for (kernel_y in 0..5) {
                for (kernel_x in 0..5) {
                    let input_index: int = input_channel * input_size * input_size +
                        (y + kernel_y) * input_size + x + kernel_x;
                    let weight_index: int =
                        ((channel * input_channels + input_channel) * 5 +
                         kernel_y) * 5 + kernel_x;
                    sum = sum + input[input_index] * weight[weight_index];
                }
            }
        }
        output[i] = 0.0;
        if (sum > 0.0) {
            output[i] = sum;
        }
    }
}

func cifar_cpu_max_pool2x2(
    input: rpackedfloat, output: rpackedfloat,
    channels: int, input_size: int, output_size: int) {
    for (i in 0..channels * output_size * output_size) {
        let channel: int = i / (output_size * output_size);
        let spatial: int = i % (output_size * output_size);
        let y: int = spatial / output_size;
        let x: int = spatial % output_size;
        let input_base: int = channel * input_size * input_size +
            y * 2 * input_size + x * 2;
        var maximum: float = input[input_base];
        if (input[input_base + 1] > maximum) {
            maximum = input[input_base + 1];
        }
        if (input[input_base + input_size] > maximum) {
            maximum = input[input_base + input_size];
        }
        if (input[input_base + input_size + 1] > maximum) {
            maximum = input[input_base + input_size + 1];
        }
        output[i] = maximum;
    }
}

func cifar_cpu_dense(
    input: rpackedfloat, weight: rpackedfloat, bias: rpackedfloat,
    output: rpackedfloat, input_count: int, output_count: int, relu: int) {
    for (i in 0..output_count) {
        let base: int = i * input_count;
        var sum: float = bias[i];
        for (j in 0..input_count) {
            sum = sum + input[j] * weight[base + j];
        }
        if (relu == 0) {
            output[i] = sum;
        }
        if (relu != 0) {
            output[i] = 0.0;
            if (sum > 0.0) {
                output[i] = sum;
            }
        }
    }
}

