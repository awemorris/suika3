__accel func grid_stride(input: rpackeduint32_in,
                         output: rpackeduint32_out,
                         count: int): void {
    for (i in 0..count) {
        output[i] = input[i] + 1;
    }
}

func main() {
    let input = Packed.uint32(4194304);
    let output = Packed.uint32(4194304);
    input[4194303] = 41;
    Accel.call(grid_stride, input, output, 4194304);
    print(output[0]);
    print(output[4194303]);
}
