// Essence of DRAW_IMAGE_DIM: normal alpha blend with source RGB at 50%.
func blend_dim(dst: rpackeduint32, src: rpackeduint32,
               alpha: int, n: int): void {
    let alpha_float = alpha / 65025.0;
    for (i in 0..n) {
        let dst_pix = dst[i];
        let src_pix = src[i];
        let src_a = Float.from((src_pix >> 24) & 0xff) * alpha_float;
        let dst_a = 1.0 - src_a;
        let dim_a = src_a * 0.5;
        let r = Float.from((src_pix >> 16) & 0xff) * dim_a +
                Float.from((dst_pix >> 16) & 0xff) * dst_a;
        let g = Float.from((src_pix >> 8) & 0xff) * dim_a +
                Float.from((dst_pix >> 8) & 0xff) * dst_a;
        let b = Float.from(src_pix & 0xff) * dim_a +
                Float.from(dst_pix & 0xff) * dst_a;
        dst[i] = (255 << 24) | (Int.from(r) << 16) |
                 (Int.from(g) << 8) | Int.from(b);
    }
}

func main() {
    let src = Packed.uint32(16);
    let dst = Packed.uint32(16);
    src[0] = 0x804080c0;
    dst[0] = 0xffc08040;
    blend_dim(dst, src, 128, 16);
    print(dst[0]);
    print(dst[15]);
}
