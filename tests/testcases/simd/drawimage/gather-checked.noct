func gather_copy(dst: rpackeduint32, src: rpackeduint32,
                 index: rpackeduint32, n: int): void {
    for (i in 0..n) {
        dst[i] = src[index[i]];
    }
}

func main() {
    let src = Packed.uint32(16);
    let dst = Packed.uint32(16);
    let index = Packed.uint32(16);
    src[0] = 101;
    src[15] = 202;
    index[0] = 15;
    index[1] = 0;
    gather_copy(dst, src, index, 16);
    print(dst[0]);
    print(dst[1]);
    print(dst[15]);
}
