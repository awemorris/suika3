func doall_distinct(src: rpackeduint32, dst: rpackeduint32, n: int): void {
    for (i in 0..n) {
        dst[i] = src[i] + 1;
    }
}

func mayalias_distinct(src: packeduint32, dst: packeduint32, n: int): void {
    for (i in 0..n) {
        dst[i] = src[i] + 1;
    }
}

func doall_inplace(data: packeduint32, n: int): void {
    for (i in 0..n) {
        data[i] = data[i] + 1;
    }
}

func dependent_neighbor(data: packeduint32, n: int): void {
    for (i in 1..n) {
        data[i] = data[i - 1] + 1;
    }
}

func dependent_constant(data: packeduint32, n: int): void {
    for (i in 0..n) {
        data[0] = i;
    }
}

func dependent_scalar(src: rpackeduint32, dst: rpackeduint32, n: int): void {
    var carry: int = 0;
    for (i in 0..n) {
        carry = carry + 1;
        dst[i] = src[i] + carry;
    }
}

func nonaffine_read(src: rpackeduint32, dst: rpackeduint32,
                    index: rpackeduint32, n: int): void {
    for (i in 0..n) {
        dst[i] = src[index[i]];
    }
}

func nonaffine_write(dst: packeduint32, index: packeduint32, n: int): void {
    for (i in 0..n) {
        dst[index[i]] = i;
    }
}

func symbolic_inplace(data: packeduint32, n: int, shift: int): void {
    for (i in 0..n) {
        data[i + shift] = data[shift + i] + 1;
    }
}

func symbolic_dependent(data: packeduint32, n: int,
                        left: int, right: int): void {
    for (i in 0..n) {
        data[i + left] = data[i + right] + 1;
    }
}

func unknown_call(dst: packeduint32, n: int): void {
    for (i in 0..n) {
        dst[i] = random();
    }
}

func dosum_int(src: rpackedint32, n: int): void {
    var sum: i32 = 0;
    for (i in 0..n) {
        sum = sum + src[i];
    }
    print(sum);
}

func dosum_float(src: rpackedfloat, n: int): void {
    var sum: float = 0.0;
    for (i in 0..n) {
        sum = src[i] + sum;
    }
    print(sum);
}

func variant_offset(dst: packeduint32, n: int): void {
    for (i in 0..n) {
        var shift: int = 0 - i;
        dst[i + shift] = i;
    }
}

