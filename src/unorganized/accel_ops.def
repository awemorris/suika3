/*
 * Stable raw-GPU operation registry.
 *
 * ACCEL_MATH_OP(symbol, id, source, arity, scalar_types, capabilities,
 *               lowering, exceptional_policy, absolute_tolerance,
 *               relative_tolerance)
 *
 * Numeric IDs are protocol-like compiler identities.  Never derive them from
 * this file's order and never reuse a retired ID.
 */
ACCEL_MATH_OP(ABS,         1, "Accel.abs",         1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(NEG,         2, "Accel.neg",         1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(ADD,         3, "Accel.add",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(SUB,         4, "Accel.sub",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(MUL,         5, "Accel.mul",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(DIV,         6, "Accel.div",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(MIN,         7, "Accel.min",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_NAN_ZERO_EXPLICIT, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(MAX,         8, "Accel.max",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_NAN_ZERO_EXPLICIT, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(CLIP,        9, "Accel.clip",        3, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_NAN_ZERO_EXPLICIT, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(SIGMOID,    10, "Accel.sigmoid",     1, ACCEL_SCALAR_FLOAT32, ACCEL_OP_CAP_RAW_GLSL | ACCEL_OP_CAP_OPENGL, ACCEL_LOWER_SIGMOID, ACCEL_EXCEPTION_SIGMOID_STABLE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(RELU,       11, "Accel.relu",        1, ACCEL_SCALAR_FLOAT32, ACCEL_OP_CAP_RAW_GLSL | ACCEL_OP_CAP_OPENGL, ACCEL_LOWER_RELU, ACCEL_EXCEPTION_NAN_ZERO_EXPLICIT, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(LEAKY_RELU, 12, "Accel.leakyRelu",   2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_NAN_ZERO_EXPLICIT, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(TANH,       13, "Accel.tanh",        1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(EXP,        14, "Accel.exp",         1, ACCEL_SCALAR_FLOAT32, ACCEL_OP_CAP_RAW_GLSL | ACCEL_OP_CAP_OPENGL, ACCEL_LOWER_EXP, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(LOG,        15, "Accel.log",         1, ACCEL_SCALAR_FLOAT32, ACCEL_OP_CAP_RAW_GLSL | ACCEL_OP_CAP_OPENGL, ACCEL_LOWER_LOG, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(SQRT,       16, "Accel.sqrt",        1, ACCEL_SCALAR_FLOAT32, ACCEL_OP_CAP_RAW_GLSL | ACCEL_OP_CAP_OPENGL, ACCEL_LOWER_SQRT, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(POW,        17, "Accel.pow",         2, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(FMA,        18, "Accel.fma",         3, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 1.0e-6, 1.0e-6)
ACCEL_MATH_OP(SOFTPLUS,   19, "Accel.softplus",    1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(SILU,       20, "Accel.silu",        1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(GELU_ERF,   21, "Accel.geluErf",     1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(GELU_TANH,  22, "Accel.geluTanh",    1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
ACCEL_MATH_OP(ERF,        23, "Accel.erf",         1, ACCEL_SCALAR_FLOAT32, 0, ACCEL_LOWER_NONE, ACCEL_EXCEPTION_IEEE, 2.0e-6, 2.0e-5)
