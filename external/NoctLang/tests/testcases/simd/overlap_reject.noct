// Same packed, store at p[i], load at p[i+1]: a loop-carried memory
// dependence -- must NOT vectorize (E7), output identical anyway.
func main() {
    var n = 20;
    var p = Packed.uint32(32);
    for (i in 0..32) {
        p[i] = i;
    }
    for (i in 0..n) {
        p[i] = p[i + 1] * 3;
    }
    var sum = 0;
    for (i in 0..32) {
        sum = sum + p[i];
    }
    print(sum);
}
