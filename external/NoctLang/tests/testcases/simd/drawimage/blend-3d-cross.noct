// Essence of DRAW_IMAGE_3D_CROSS after rasterization: two texture gathers.
// Packed index streams stand in for the two affine scanline coordinate pairs.
func blend_3d_cross(dst: rpackeduint32,
                    src1: rpackeduint32, index1: rpackeduint32,
                    src2: rpackeduint32, index2: rpackeduint32,
                    alpha: int, n: int): void {
    let alpha_f = Float.from(alpha) / 255.0;
    for (i in 0..n) {
        let p1 = src1[index1[i]];
        let p2 = src2[index2[i]];
        let d = dst[i];
        let a1 = alpha_f * Float.from((p1 >> 24) & 0xff) / 255.0;
        let a2 = (1.0 - alpha_f) * Float.from((p2 >> 24) & 0xff) / 255.0;
        let da = 1.0 - (a1 + a2);
        let r = a1 * Float.from((p1 >> 16) & 0xff) +
                a2 * Float.from((p2 >> 16) & 0xff) +
                da * Float.from((d >> 16) & 0xff);
        let g = a1 * Float.from((p1 >> 8) & 0xff) +
                a2 * Float.from((p2 >> 8) & 0xff) +
                da * Float.from((d >> 8) & 0xff);
        let b = a1 * Float.from(p1 & 0xff) +
                a2 * Float.from(p2 & 0xff) +
                da * Float.from(d & 0xff);
        dst[i] = (255 << 24) | (Int.from(r) << 16) |
                 (Int.from(g) << 8) | Int.from(b);
    }
}

func main() {
    let src1 = Packed.uint32(16);
    let src2 = Packed.uint32(16);
    let index1 = Packed.uint32(4);
    let index2 = Packed.uint32(4);
    let dst = Packed.uint32(4);
    src1[0] = 0xc0f02010;
    src2[0] = 0x8040e080;
    blend_3d_cross(dst, src1, index1, src2, index2, 96, 4);
    print(dst[0]);
    print(dst[3]);
}
