func transform(dst: rpackedfloat, src: rpackedfloat, n: int,
               scale: float) {
    for (i in 0..n) {
        var t = (src[i] + 1.0) * scale;
        dst[i] = (t - 2.0) / 4.0;
    }
}

func main() {
    var src = Packed.float32(8);
    var dst = Packed.float32(8);
    src[0] = 2.0;
    src[1] = 4.0;
    src[2] = 6.0;
    src[3] = 8.0;
    src[4] = 10.0;
    src[5] = 12.0;
    src[6] = 14.0;
    src[7] = 16.0;
    transform(dst, src, 7, 3.0);
    for (i in 0..8) {
        print(dst[i]);
    }
}
