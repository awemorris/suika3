// INT_MIN / -1 (and %, and the long variants) used to raise SIGFPE
// and kill the process; they now wrap like the typed helpers.
func main() {
    var imin = -2147483647 - 1;
    var m1 = 0 - 1;
    print(imin / m1);
    print(imin % m1);
    var lmin = -9223372036854775807 - 1;
    var lm1 = 0 - 1;
    print(lmin / lm1);
    print(lmin % lm1);
    print(lmin / m1);
    print(lmin % m1);
    return 0;
}
