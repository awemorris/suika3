static let bias = 1;

static __inline func make_pixel(r: int, g: int, b: int): int {
    return (r << 16) | (g << 8) | b;
}

static func add_bias(x: int): int {
    return x + bias;
}

func procedure(): void {
    print("procedure");
    return;
}

func main() {
    procedure();
    print(make_pixel(18, 52, 86));
    print(add_bias(9));
}
