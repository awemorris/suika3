func main() {
    var n = 200;
    var p = Packed.int64(n);
    for (i in 0..n) {
        p[i] = i * 1000;
    }
    var sum = 0;
    for (i in 0..n) {
        sum = sum + p[i];
    }
    print(sum);
    for (i in 0..n) {
        p[i] = p[i] + 1;
    }
    var s2 = 0;
    for (i in 0..n) {
        s2 = s2 + p[i];
    }
    print(s2);
}
