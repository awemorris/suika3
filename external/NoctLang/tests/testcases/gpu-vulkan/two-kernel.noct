__accel func transform(
    source: rpackedint32,
    destination: rpackedint32,
    n: int): void {
    for (i in 0..n) {
        destination[i] = source[i] + 1;
    }
    for (j in 0..n) {
        destination[j] = destination[j] * 3;
    }
}

func main() {
    let source = Packed.int32(4);
    let destination = Packed.int32(4);
    for (i in 0..4) {
        source[i] = i;
    }
    transform(source, destination, 4);
    for (i in 0..4) {
        print(destination[i]);
    }
}
