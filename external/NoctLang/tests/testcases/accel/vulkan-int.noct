__accel func add_bias(
    input: rpackedint32_in,
    output: rpackedint32_out,
    count: int,
    bias: int
): void {
    for (i in 0..count) {
        output[i] = input[i] + bias;
    }
}

func main() {
    let input = Packed.int32(2);
    let output = Packed.int32(2);
    input[0] = -1;
    input[1] = -2;
    Accel.call(add_bias, input, output, 2, -3);
    print(output[0]);
    print(output[1]);
}
