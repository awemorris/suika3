__accel func add_one(
    input: rpackeduint32_in,
    output: rpackeduint32_out,
    count: int
): void {
    for (i in 0..count) {
        output[i] = input[i] + 1;
    }
}

func main() {
    let input = Packed.uint32(1);
    let output = Packed.uint32(1);
    output[0] = 17;
    let event = Accel.callAsync(add_one, input, output, 0);
    Accel.join(event);
    print(output[0]);
}
