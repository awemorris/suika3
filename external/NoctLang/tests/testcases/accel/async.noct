__accel func add_one(
    input: rpackeduint32_in,
    output: rpackeduint32_out,
    count: int
): void {
    for (i in 0..count) {
        output[i] = input[i] + 1;
    }
}

func main() {
    let input = Packed.uint32(2);
    let output = Packed.uint32(2);
    input[0] = 4;
    input[1] = 8;
    let event = Accel.callAsync(add_one, input, output, 2);
    Accel.join(event);
    print(output[0]);
    print(output[1]);
}
