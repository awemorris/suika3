func worker(counter) {
    for (i in 0..10000) {
        Thread.incrementCounter(counter);
    }
    return 0;
}

func main() {
    var c = Thread.createCounter();
    var ths = [];
    for (t in 0..4) {
        ths[t] = Thread.createThread(worker, c);
    }
    for (t in 0..4) {
        Thread.joinThread(ths[t]);
    }
    print(Thread.getCounter(c));
}
