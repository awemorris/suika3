__accel func transform(
    source: rpackedint32,
    destination: rpackedint32,
    float_source: rpackedfloat,
    float_destination: rpackedfloat,
    n: int): void {
    for (i in 0..n) {
        destination[i] = source[i] + 1;
    }
    var separator: int = n + 1;
    for (j in 0..n) {
        float_destination[j] = -float_source[j];
    }
}

func main() {
}
