msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "  --gc-graduate-size=N ... second GC space size in bytes\n"
msgstr "  --gc-graduate-size=N ... μέγεθος του δεύτερου χώρου GC σε byte\n"

msgid "  --gc-lop-threshold=N ... move objects larger than N-bytes to final GC space\n"
msgstr "  --gc-lop-threshold=N ... μεταφορά αντικειμένων μεγαλύτερων από N byte στον τελικό χώρο GC\n"

msgid "  --gc-nursery-size=N  ... first GC space size in bytes\n"
msgstr "  --gc-nursery-size=N  ... μέγεθος του πρώτου χώρου GC σε byte\n"

msgid "  --gc-tenure-size=N   ... final GC space size in bytes\n"
msgstr "  --gc-tenure-size=N   ... μέγεθος του τελικού χώρου GC σε byte\n"

msgid "  --gpu-list           ... list suitable GPU device selectors\n"
msgstr "  --gpu-list           ... εμφάνιση κατάλληλων επιλογέων συσκευής GPU\n"

msgid "  --gpu[=SELECTOR]     ... use GPU acceleration for source execution\n"
msgstr "  --gpu[=SELECTOR]     ... χρήση επιτάχυνσης GPU για την εκτέλεση του πηγαίου κώδικα\n"

msgid "  --path=DIR1:DIR2     ... append source-module search paths\n"
msgstr "  --path=DIR1:DIR2     ... προσθήκη διαδρομών αναζήτησης μονάδων πηγαίου κώδικα\n"

msgid "  --simd-info          ... report successfully vectorized loops\n"
msgstr "  --simd-info          ... αναφορά των βρόχων που διανυσματοποιήθηκαν επιτυχώς\n"

msgid "  -O, -O0..-O3, -O9    ... optimization preset\n"
msgstr "  -O, -O0..-O3, -O9    ... προεπιλογή βελτιστοποίησης\n"

msgid "  -j, -j0              ... eager JIT (default), or interpreter only\n"
msgstr "  -j, -j0              ... άμεση μεταγλώττιση JIT (προεπιλογή) ή μόνο διερμηνευτής\n"

msgid "  noct --ansic <out-file> <in-files>  ... convert to a C source file\n"
msgstr "  noct --ansic <out-file> <in-files>  ... μετατροπή σε αρχείο πηγαίου κώδικα C\n"

msgid "  noct --compile <in-files>           ... convert to bytecode files\n"
msgstr "  noct --compile <in-files>           ... μετατροπή σε αρχεία bytecode\n"

msgid "  noct --elisp <out-file> <in-files>  ... convert to an Emacs Lisp source file\n"
msgstr "  noct --elisp <out-file> <in-files>  ... μετατροπή σε αρχείο πηγαίου κώδικα Emacs Lisp\n"

msgid "  noct --scheme <out-file> <in-files> ... convert to an Scheme source file\n"
msgstr "  noct --scheme <out-file> <in-files> ... μετατροπή σε αρχείο πηγαίου κώδικα Scheme\n"

msgid "  noct <vm-options> <files>           ... run a program\n"
msgstr "  noct <vm-options> <files>           ... εκτέλεση προγράμματος\n"

msgid "%s"
msgstr "%s"

msgid "%s\n"
msgstr "%s\n"

msgid "%s accelerator %s."
msgstr "Επιταχυντής %s %s."

msgid "%s accelerator %s: %s"
msgstr "Επιταχυντής %s %s: %s"

msgid "%s accelerator context is detached."
msgstr "Το περιβάλλον του επιταχυντή %s έχει αποσυνδεθεί."

msgid "%s accelerator program changed during begin."
msgstr "Το πρόγραμμα του επιταχυντή %s άλλαξε κατά την έναρξη."

msgid "%s accelerator program is not published."
msgstr "Το πρόγραμμα του επιταχυντή %s δεν έχει δημοσιευτεί."

msgid "%s accelerator session changed during dispatch."
msgstr "Η συνεδρία του επιταχυντή %s άλλαξε κατά την αποστολή."

msgid "%s accelerator session changed during finish."
msgstr "Η συνεδρία του επιταχυντή %s άλλαξε κατά την ολοκλήρωση."

msgid "%s accelerator session changed while publishing results."
msgstr "Η συνεδρία του επιταχυντή %s άλλαξε κατά τη δημοσίευση των αποτελεσμάτων."

msgid "%s failed."
msgstr "Το %s απέτυχε."

msgid "%s is unavailable."
msgstr "Το %s δεν είναι διαθέσιμο."

msgid "%s() is not defined\n"
msgstr "Η %s() δεν έχει οριστεί\n"

msgid "%s() must have zero or one parameter\n"
msgstr "Η %s() πρέπει να έχει μηδέν ή μία παράμετρο\n"

msgid "%s(): Function arguments not match."
msgstr "%s(): Τα ορίσματα της συνάρτησης δεν ταιριάζουν."

msgid "%s(): argument type mismatch (expected %s)."
msgstr "%s(): ασυμφωνία τύπου ορίσματος (αναμενόταν %s)."

msgid "%s(): local type mismatch (expected %s)."
msgstr "%s(): ασυμφωνία τύπου τοπικής μεταβλητής (αναμενόταν %s)."

msgid "%s(): return type mismatch (expected %s)."
msgstr "%s(): ασυμφωνία τύπου επιστροφής (αναμενόταν %s)."

msgid "%s: Out of memory while parsing."
msgstr "%s: Δεν υπάρχει αρκετή μνήμη κατά την ανάλυση."

msgid "%s:%d: Error: %s\n"
msgstr "%s:%d: Σφάλμα: %s\n"

msgid "--gpu-list may be specified only once.\n"
msgstr "Η --gpu-list μπορεί να καθοριστεί μόνο μία φορά.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "Η --gpu-list πρέπει να χρησιμοποιείται μόνη της.\n"

msgid "A __fast array index must be int or long."
msgstr "Ένας δείκτης πίνακα __fast πρέπει να είναι int ή long."

msgid "A __fast assignment requires an exact type match."
msgstr "Μια ανάθεση __fast απαιτεί ακριβή αντιστοίχιση τύπων."

msgid "A __fast assignment target must be a typed local."
msgstr "Ο στόχος ανάθεσης __fast πρέπει να είναι τοπική μεταβλητή με τύπο."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Μια δυαδική ενσωματωμένη συνάρτηση __fast απαιτεί τελεστέους του ίδιου τύπου."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Μια δυαδική πράξη __fast απαιτεί ίδιους πρωτογενείς τύπους τελεστέων."

msgid "A __fast condition must have type int."
msgstr "Μια συνθήκη __fast πρέπει να έχει τύπο int."

msgid "A __fast expression is too deeply nested."
msgstr "Μια έκφραση __fast είναι υπερβολικά βαθιά εμφωλευμένη."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "Μια func __fast μπορεί να καλεί απευθείας μόνο μια συνάρτηση __fast ή μια ενσωματωμένη συνάρτηση."

msgid "A __fast func must declare its return type."
msgstr "Μια func __fast πρέπει να δηλώνει τον τύπο επιστροφής της."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Μια παράμετρος func __fast πρέπει να είναι πρωτογενής ή rpacked με σχήμα."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "Ο τύπος επιστροφής μιας func __fast πρέπει να είναι void, int, long, float ή double."

msgid "A __fast func supports only ranged for loops."
msgstr "Μια func __fast υποστηρίζει μόνο βρόχους for με εύρος."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "Το όνομα μιας συνάρτησης __fast συγκρούεται με ενσωματωμένη συνάρτηση του μεταγλωττιστή."

msgid "A __fast integer operation requires int or long."
msgstr "Μια ακέραια πράξη __fast απαιτεί int ή long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Μια ενσωματωμένη συνάρτηση __fast απαιτεί στατικά τυποποιημένο αριθμητικό όρισμα."

msgid "A __fast logical operand must have type int."
msgstr "Ένας λογικός τελεστέος __fast πρέπει να έχει τύπο int."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Μια αριθμητική ενσωματωμένη συνάρτηση __fast απαιτεί αριθμητικά ορίσματα."

msgid "A __fast packed access is provably out of bounds."
msgstr "Μια πρόσβαση packed __fast είναι αποδεδειγμένα εκτός ορίων."

msgid "A __fast packed store requires an exact element type match."
msgstr "Μια αποθήκευση packed __fast απαιτεί ακριβή αντιστοίχιση τύπου στοιχείου."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "Το σχήμα μιας παραμέτρου __fast έχει περισσότερες από 8 διαστάσεις."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Ένας βρόχος εύρους __fast απαιτεί αντίστοιχα όρια int ή long."

msgid "A __fast return value does not match its declared type."
msgstr "Μια τιμή επιστροφής __fast δεν αντιστοιχεί στον δηλωμένο τύπο της."

msgid "A __fast shape extent must be int or long."
msgstr "Η έκταση ενός σχήματος __fast πρέπει να είναι int ή long."

msgid "A __fast shape extent must be positive."
msgstr "Η έκταση ενός σχήματος __fast πρέπει να είναι θετική."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "Η βάση ενός δείκτη __fast πρέπει να είναι παράμετρος rpacked με σχήμα."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Μια υπερβατική ενσωματωμένη συνάρτηση __fast απαιτεί float ή double."

msgid "A __fast unary operand must be primitive."
msgstr "Ένας μοναδιαίος τελεστέος __fast πρέπει να είναι πρωτογενής."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Μια δυαδική ενσωματωμένη συνάρτηση __fast απαιτεί τελεστέους του ίδιου τύπου."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Ένα όρισμα άμεσης κλήσης __fast δεν αντιστοιχεί στον τύπο της καλούμενης συνάρτησης."

msgid "A direct __fast call has the wrong argument count."
msgstr "Μια άμεση κλήση __fast έχει εσφαλμένο πλήθος ορισμάτων."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Ένα όρισμα packed άμεσης κλήσης __fast έχει εσφαλμένο τύπο στοιχείου."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Ένα όρισμα packed άμεσης κλήσης __fast πρέπει να είναι παράμετρος."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "Το σχήμα packed μιας άμεσης κλήσης __fast δεν αντιστοιχεί στην προβολή της καλούμενης συνάρτησης."

msgid "A direct __fast call packed shape rank does not match."
msgstr "Ο αριθμός διαστάσεων του σχήματος packed μιας άμεσης κλήσης __fast δεν αντιστοιχεί."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Μια δυναμική έκταση σχήματος __fast πρέπει να ονομάζει παράμετρο int ή long."

msgid "A function return type cannot have a shape."
msgstr "Ο τύπος επιστροφής μιας συνάρτησης δεν μπορεί να έχει σχήμα."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Μια τοπική μεταβλητή που χρησιμοποιείται μέσα σε func __fast πρέπει να έχει ακριβή πρωτογενή τύπο."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Ένας πολυδιάστατος δείκτης απαιτεί άμεσα κατονομασμένη παράμετρο με σχήμα."

msgid "A non-void __fast func must return a value."
msgstr "Μια func __fast που δεν είναι void πρέπει να επιστρέφει τιμή."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Μια πρωτογενής παράμετρος __fast δεν μπορεί να έχει σχήμα."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Μια πρωτογενής παράμετρος __fast πρέπει να χρησιμοποιεί ακριβώς int, long, float ή double."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Μια περιορισμένη παράμετρος packed __fast απαιτεί ακριβές σχήμα."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Ένας περιορισμένος τύπος packed είναι έγκυρος μόνο για παράμετρο."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Μια παράμετρος __fast με σχήμα πρέπει να είναι τύπου Packed."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Μια υπερβατική ενσωματωμένη συνάρτηση __fast απαιτεί float ή double."

msgid "A typed function must return a value."
msgstr "Μια συνάρτηση με τύπο πρέπει να επιστρέφει τιμή."

msgid "A void function cannot return a value."
msgstr "Μια συνάρτηση void δεν μπορεί να επιστρέφει τιμή."

msgid "Accelerator Packed argument is missing."
msgstr "Λείπει το όρισμα Packed του επιταχυντή."

msgid "Accelerator Packed element type does not match."
msgstr "Ο τύπος στοιχείου Packed του επιταχυντή δεν αντιστοιχεί."

msgid "Accelerator VM and environment do not match."
msgstr "Η VM του επιταχυντή και το περιβάλλον δεν αντιστοιχούν."

msgid "Accelerator access has an invalid effect."
msgstr "Η πρόσβαση του επιταχυντή έχει μη έγκυρη επίδραση."

msgid "Accelerator access has no buffer binding."
msgstr "Η πρόσβαση του επιταχυντή δεν έχει δέσμευση ενδιάμεσης μνήμης."

msgid "Accelerator access references an unknown buffer."
msgstr "Η πρόσβαση του επιταχυντή αναφέρεται σε άγνωστη ενδιάμεση μνήμη."

msgid "Accelerator argument count changed."
msgstr "Το πλήθος ορισμάτων του επιταχυντή άλλαξε."

msgid "Accelerator argument count is too large."
msgstr "Το πλήθος ορισμάτων του επιταχυντή είναι υπερβολικά μεγάλο."

msgid "Accelerator backend failed to prepare a program."
msgstr "Το backend του επιταχυντή απέτυχε να προετοιμάσει πρόγραμμα."

msgid "Accelerator backend returned no program."
msgstr "Το backend του επιταχυντή δεν επέστρεψε πρόγραμμα."

msgid "Accelerator buffer access is out of range."
msgstr "Η πρόσβαση στην ενδιάμεση μνήμη του επιταχυντή είναι εκτός ορίων."

msgid "Accelerator buffer has no required range."
msgstr "Η ενδιάμεση μνήμη του επιταχυντή δεν έχει το απαιτούμενο εύρος."

msgid "Accelerator buffer has no runtime argument slot."
msgstr "Η ενδιάμεση μνήμη του επιταχυντή δεν έχει θέση ορίσματος περιβάλλοντος εκτέλεσης."

msgid "Accelerator buffer range overflowed."
msgstr "Υπήρξε υπερχείλιση του εύρους της ενδιάμεσης μνήμης του επιταχυντή."

msgid "Accelerator buffer size overflowed."
msgstr "Υπήρξε υπερχείλιση του μεγέθους της ενδιάμεσης μνήμης του επιταχυντή."

msgid "Accelerator context is unavailable."
msgstr "Το περιβάλλον του επιταχυντή δεν είναι διαθέσιμο."

msgid "Accelerator context reference limit reached."
msgstr "Συμπληρώθηκε το όριο αναφορών του περιβάλλοντος του επιταχυντή."

msgid "Accelerator device buffer is read before definition."
msgstr "Η ενδιάμεση μνήμη συσκευής του επιταχυντή διαβάζεται πριν από τον ορισμό της."

msgid "Accelerator device buffer size is not positive."
msgstr "Το μέγεθος της ενδιάμεσης μνήμης συσκευής του επιταχυντή δεν είναι θετικό."

msgid "Accelerator device buffer size is too large."
msgstr "Το μέγεθος της ενδιάμεσης μνήμης συσκευής του επιταχυντή είναι υπερβολικά μεγάλο."

msgid "Accelerator device buffer size overflowed."
msgstr "Υπήρξε υπερχείλιση του μεγέθους της ενδιάμεσης μνήμης συσκευής του επιταχυντή."

msgid "Accelerator device-list visitor failed."
msgstr "Ο επισκέπτης λίστας συσκευών του επιταχυντή απέτυχε."

msgid "Accelerator dispatch range is too large."
msgstr "Το εύρος αποστολής του επιταχυντή είναι υπερβολικά μεγάλο."

msgid "Accelerator function is not registered in the HIR table."
msgstr "Η συνάρτηση του επιταχυντή δεν είναι καταχωρισμένη στον πίνακα HIR."

msgid "Accelerator load has no buffer binding."
msgstr "Η φόρτωση του επιταχυντή δεν έχει δέσμευση ενδιάμεσης μνήμης."

msgid "Accelerator local name collision."
msgstr "Σύγκρουση ονομάτων τοπικών μεταβλητών του επιταχυντή."

msgid "Accelerator local name is too long."
msgstr "Το όνομα τοπικής μεταβλητής του επιταχυντή είναι υπερβολικά μεγάλο."

msgid "Accelerator loop start overflowed."
msgstr "Υπήρξε υπερχείλιση της αρχής βρόχου του επιταχυντή."

msgid "Accelerator output argument is missing."
msgstr "Λείπει το όρισμα εξόδου του επιταχυντή."

msgid "Accelerator output size changed."
msgstr "Το μέγεθος εξόδου του επιταχυντή άλλαξε."

msgid "Accelerator output snapshot is missing."
msgstr "Λείπει το στιγμιότυπο εξόδου του επιταχυντή."

msgid "Accelerator output type changed."
msgstr "Ο τύπος εξόδου του επιταχυντή άλλαξε."

msgid "Accelerator plan does not match live HIR."
msgstr "Το σχέδιο του επιταχυντή δεν αντιστοιχεί στο ενεργό HIR."

msgid "Accelerator program validation failed."
msgstr "Η επικύρωση του προγράμματος του επιταχυντή απέτυχε."

msgid "Accelerator reduction has no result entry."
msgstr "Η αναγωγή του επιταχυντή δεν έχει καταχώριση αποτελέσματος."

msgid "Accelerator scalar argument is missing."
msgstr "Λείπει το βαθμωτό όρισμα του επιταχυντή."

msgid "Accelerator scalar metadata is too large."
msgstr "Τα βαθμωτά μεταδεδομένα του επιταχυντή είναι υπερβολικά μεγάλα."

msgid "Accelerator scalar result argument is missing."
msgstr "Λείπει το όρισμα βαθμωτού αποτελέσματος του επιταχυντή."

msgid "Accelerator scalar result has no local."
msgstr "Το βαθμωτό αποτέλεσμα του επιταχυντή δεν έχει τοπική μεταβλητή."

msgid "Accelerator scalar result identity changed."
msgstr "Η ταυτότητα του βαθμωτού αποτελέσματος του επιταχυντή άλλαξε."

msgid "Accelerator scalar result is not available."
msgstr "Το βαθμωτό αποτέλεσμα του επιταχυντή δεν είναι διαθέσιμο."

msgid "Accelerator scalar result metadata is missing."
msgstr "Λείπουν τα μεταδεδομένα βαθμωτού αποτελέσματος του επιταχυντή."

msgid "Accelerator scalar result metadata is too large."
msgstr "Τα μεταδεδομένα βαθμωτού αποτελέσματος του επιταχυντή είναι υπερβολικά μεγάλα."

msgid "Accelerator store has no buffer binding."
msgstr "Η αποθήκευση του επιταχυντή δεν έχει δέσμευση ενδιάμεσης μνήμης."

msgid "Accelerator trip count overflowed."
msgstr "Υπήρξε υπερχείλιση του πλήθους επαναλήψεων του επιταχυντή."

msgid "Adding file %s.\n"
msgstr "Προσθήκη του αρχείου %s.\n"

msgid "An accelerator is already attached to this VM."
msgstr "Ένας επιταχυντής είναι ήδη συνδεδεμένος σε αυτήν τη VM."

msgid "An active Vulkan buffer has no storage."
msgstr "Μια ενεργή ενδιάμεση μνήμη Vulkan δεν έχει χώρο αποθήκευσης."

msgid "An inactive Vulkan buffer requested a transfer."
msgstr "Μια ανενεργή ενδιάμεση μνήμη Vulkan ζήτησε μεταφορά."

msgid "Application container cannot be used as a module: %s"
msgstr "Ο περιέκτης της εφαρμογής δεν μπορεί να χρησιμοποιηθεί ως μονάδα: %s"

msgid "Application contains an unreachable module."
msgstr "Η εφαρμογή περιέχει μη προσβάσιμη μονάδα."

msgid "Application output %s collides with input %s.\n"
msgstr "Η έξοδος %s της εφαρμογής συγκρούεται με την είσοδο %s.\n"

msgid "Argument (%d: %s) is not a dictionary."
msgstr "Το όρισμα (%d: %s) δεν είναι λεξικό."

msgid "Argument (%d: %s) is not a double."
msgstr "Το όρισμα (%d: %s) δεν είναι double."

msgid "Argument (%d: %s) is not a float."
msgstr "Το όρισμα (%d: %s) δεν είναι δεκαδικός αριθμός."

msgid "Argument (%d: %s) is not a function."
msgstr "Το όρισμα (%d: %s) δεν είναι συνάρτηση."

msgid "Argument (%d: %s) is not a long."
msgstr "Το όρισμα (%d: %s) δεν είναι long."

msgid "Argument (%d: %s) is not a packed of type %s."
msgstr "Το όρισμα (%d: %s) δεν είναι packed τύπου %s."

msgid "Argument (%d: %s) is not a packed."
msgstr "Το όρισμα (%d: %s) δεν είναι packed."

msgid "Argument (%d: %s) is not a string."
msgstr "Το όρισμα (%d: %s) δεν είναι συμβολοσειρά."

msgid "Argument (%d: %s) is not an array."
msgstr "Το όρισμα (%d: %s) δεν είναι πίνακας."

msgid "Argument (%d: %s) is not an int."
msgstr "Το όρισμα (%d: %s) δεν είναι ακέραιος αριθμός."

msgid "Argument (%d: %s) is not an integer."
msgstr "Το όρισμα (%d: %s) δεν είναι ακέραιος αριθμός."

msgid "Array index %ld is out-of-range."
msgstr "Ο δείκτης πίνακα %ld είναι εκτός ορίων."

msgid "BeUI is not open."
msgstr "Το BeUI δεν είναι ανοικτό."

msgid "BeUI.destroyImage received an invalid handle."
msgstr "Η BeUI.destroyImage έλαβε μη έγκυρο handle."

msgid "BeUI.drawImage failed."
msgstr "Η BeUI.drawImage απέτυχε."

msgid "BeUI.drawImagePattern failed."
msgstr "Η BeUI.drawImagePattern απέτυχε."

msgid "BeUI.drawImagePattern received an invalid argument."
msgstr "Η BeUI.drawImagePattern έλαβε μη έγκυρο όρισμα."

msgid "BeUI.drawImageRegion failed."
msgstr "Η BeUI.drawImageRegion απέτυχε."

msgid "BeUI.drawText failed."
msgstr "Η BeUI.drawText απέτυχε."

msgid "BeUI.drawText received an invalid argument."
msgstr "Η BeUI.drawText έλαβε μη έγκυρο όρισμα."

msgid "BeUI.fill failed."
msgstr "Η BeUI.fill απέτυχε."

msgid "BeUI.fill received an invalid argument."
msgstr "Η BeUI.fill έλαβε μη έγκυρο όρισμα."

msgid "BeUI.flush failed."
msgstr "Η BeUI.flush απέτυχε."

msgid "BeUI.getImageHeight received an invalid handle."
msgstr "Η BeUI.getImageHeight έλαβε μη έγκυρο handle."

msgid "BeUI.getImageWidth received an invalid handle."
msgstr "Η BeUI.getImageWidth έλαβε μη έγκυρο handle."

msgid "BeUI.getMilliseconds is unavailable."
