msgid "--gpu-list may be specified only once.\n"
msgstr "--gpu-list può essere specificata una sola volta.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "--gpu-list deve essere usata da sola.\n"

msgid "A __fast array index must be int or long."
msgstr "Un indice di array __fast deve essere int o long."

msgid "A __fast assignment requires an exact type match."
msgstr "Un'assegnazione __fast richiede una corrispondenza esatta dei tipi."

msgid "A __fast assignment target must be a typed local."
msgstr "La destinazione di un'assegnazione __fast deve essere una variabile locale tipizzata."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Una funzione intrinseca binaria __fast richiede operandi dello stesso tipo."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Un'operazione binaria __fast richiede tipi primitivi degli operandi uguali."

msgid "A __fast condition must have type int."
msgstr "Una condizione __fast deve avere tipo int."

msgid "A __fast expression is too deeply nested."
msgstr "Un'espressione __fast è annidata troppo profondamente."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "Una func __fast può chiamare direttamente solo una funzione __fast o una funzione intrinseca."

msgid "A __fast func must declare its return type."
msgstr "Una func __fast deve dichiarare il proprio tipo restituito."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Un parametro di func __fast deve essere primitivo o un rpacked con forma."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "Il tipo restituito da una func __fast deve essere void, int, long, float o double."

msgid "A __fast func supports only ranged for loops."
msgstr "Una func __fast supporta solo cicli for con intervallo."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "Il nome di una funzione __fast è in conflitto con una funzione intrinseca del compilatore."

msgid "A __fast integer operation requires int or long."
msgstr "Un'operazione intera __fast richiede int o long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Una funzione intrinseca __fast richiede un argomento numerico tipizzato staticamente."

msgid "A __fast logical operand must have type int."
msgstr "Un operando logico __fast deve avere tipo int."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Una funzione intrinseca numerica __fast richiede argomenti numerici."

msgid "A __fast packed access is provably out of bounds."
msgstr "È dimostrabile che un accesso packed __fast è fuori dai limiti."

msgid "A __fast packed store requires an exact element type match."
msgstr "Una memorizzazione packed __fast richiede una corrispondenza esatta del tipo di elemento."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "La forma di un parametro __fast ha più di 8 dimensioni."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Un ciclo con intervallo __fast richiede limiti int o long corrispondenti."

msgid "A __fast return value does not match its declared type."
msgstr "Un valore restituito __fast non corrisponde al tipo dichiarato."

msgid "A __fast shape extent must be int or long."
msgstr "L'estensione di una forma __fast deve essere int o long."

msgid "A __fast shape extent must be positive."
msgstr "L'estensione di una forma __fast deve essere positiva."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "La base di un pedice __fast deve essere un parametro rpacked con forma."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Una funzione intrinseca trascendente __fast richiede float o double."

msgid "A __fast unary operand must be primitive."
msgstr "Un operando unario __fast deve essere primitivo."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Una funzione intrinseca binaria __fast richiede operandi dello stesso tipo."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Un argomento di una chiamata diretta __fast non corrisponde al tipo della funzione chiamata."

msgid "A direct __fast call has the wrong argument count."
msgstr "Una chiamata diretta __fast ha un numero errato di argomenti."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Un argomento packed di una chiamata diretta __fast ha il tipo di elemento errato."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Un argomento packed di una chiamata diretta __fast deve essere un parametro."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "La forma packed di una chiamata diretta __fast non corrisponde alla vista della funzione chiamata."

msgid "A direct __fast call packed shape rank does not match."
msgstr "Il numero di dimensioni della forma packed di una chiamata diretta __fast non corrisponde."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Un'estensione dinamica di forma __fast deve indicare un parametro int o long."

msgid "A function return type cannot have a shape."
msgstr "Il tipo restituito da una funzione non può avere una forma."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Una variabile locale usata in una func __fast deve avere un tipo primitivo esatto."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Un pedice multidimensionale richiede un parametro con forma indicato direttamente."

msgid "A non-void __fast func must return a value."
msgstr "Una func __fast non void deve restituire un valore."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Un parametro primitivo __fast non può avere una forma."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Un parametro primitivo __fast deve usare esattamente int, long, float o double."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Un parametro packed limitato __fast richiede una forma esatta."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Un tipo packed limitato è valido solo per un parametro."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Un parametro __fast con forma deve essere di tipo Packed."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Una funzione intrinseca trascendente __fast richiede float o double."

msgid "A typed function must return a value."
msgstr "Una funzione tipizzata deve restituire un valore."

msgid "A void function cannot return a value."
msgstr "Una funzione void non può restituire un valore."

msgid "Accelerator Packed argument is missing."
