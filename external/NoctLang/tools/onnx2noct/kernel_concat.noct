require kernel_pool;

func kernelConcatAxis(node) {
    for (i in 0..Array.size(node.attrs)) {
        if (node.attrs[i].name == "axis") { return node.attrs[i].value; }
    }
    planNodeFail(node, "normalized Concat is missing canonical axis.");
}

func kernelConcatInputIndex(tensor, outputShape, axis, prefix) {
    var outputStride = contiguousStride(outputShape, "Stage G.4 Concat output");
    var expression = "" + tensor.offset;
    for (d in 0..Array.size(outputShape)) {
        var coordinate = "i";
        if (outputStride[d] != 1) {
            coordinate = "(i / " + outputStride[d] + ")";
        }
        if (outputShape[d] != 1) {
            coordinate = "(" + coordinate + " % " + outputShape[d] + ")";
        }
        if (d == axis && prefix != 0) {
            coordinate = "(" + coordinate + " - " + prefix + ")";
        }
        if (tensor.shape[d] != 1 && tensor.stride[d] != 0) {
            expression = expression + " + " + coordinate + " * " + tensor.stride[d];
        }
    }
    return "(" + expression + ")";
}

func kernelEmitConcat(plan, step, name, signature) {
    var graph = plan.graph;
    var output = graph.tensors[step.outputTensor];
    var axis = kernelConcatAxis(step.node);
    if (Array.size(step.inputs) <= 0 || Array.size(step.inputs) > 32) {
        planNodeFail(step.node, "Stage G.4 Concat supports 1..32 inputs.");
    }
    if (!isContiguousView(output) || output.offset != 0) {
        planNodeFail(step.node, "Stage G.4 Concat requires contiguous offset-zero output.");
    }
    var uniqueStorages = kernelUniqueInputStorages(graph, step.inputs);
    var lines = [];
    Array.push(lines, "// signature: " + signature);
    Array.push(lines, "__gpu func " + name + "(");
    for (i in 0..Array.size(uniqueStorages)) {
        Array.push(lines, "    p" + i + ": rpackedfloat_ptr,");
    }
    Array.push(lines, "    out: rpackedfloat_ptr");
    Array.push(lines, "): void {");
    Array.push(lines, "    let i: int = globalIdx.x;");
    var count = shapeElements(output.shape, "Stage G.4 Concat output");
    var outputStride = contiguousStride(output.shape, "Stage G.4 Concat axis");
    var axisCoordinate = "i";
    if (outputStride[axis] != 1) { axisCoordinate = "(i / " + outputStride[axis] + ")"; }
    if (output.shape[axis] != 1) {
        axisCoordinate = "(" + axisCoordinate + " % " + output.shape[axis] + ")";
    }
    Array.push(lines, "    if (i < " + count + ") {");
    Array.push(lines, "        let axis_coordinate: int = " + axisCoordinate + ";");
    Array.push(lines, "        var value: float = 0.0;");
    var prefix = 0;
    for (j in 0..Array.size(step.inputs)) {
        var tensor = graph.tensors[step.inputs[j]];
        var end = prefix + tensor.shape[axis];
        var param = kernelInputParam(graph, step.inputs, j);
        var index = kernelConcatInputIndex(tensor, output.shape, axis, prefix);
        Array.push(lines, "        if (axis_coordinate >= " + prefix + ") {");
        Array.push(lines, "            if (axis_coordinate < " + end + ") {");
        Array.push(lines, "                value = " + param + "[" + index + "];");
        Array.push(lines, "            }");
        Array.push(lines, "        }");
        prefix = end;
    }
    Array.push(lines, "        out[i] = value;");
    Array.push(lines, "    }");
    Array.push(lines, "}");
    return lines;
}
