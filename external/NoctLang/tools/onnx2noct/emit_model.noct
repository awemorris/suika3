require kernel_registry;

let ONNX_STAGE_F_SOURCE_LIMIT = 1048576;

func sourceAppend(lines, line) { Array.push(lines, line); }

func sourceAppendAll(lines, more) {
    for (i in 0..Array.size(more)) { Array.push(lines, more[i]); }
}

func sourceWriteLines(path, lines) {
    var total = 0L;
    for (i in 0..Array.size(lines)) {
        total = checkedAddPositive(total, String.byteLength(lines[i]) + 1,
                                   "generated source size");
        if (total > ONNX_STAGE_F_SOURCE_LIMIT) {
            normFail("Stage F generated source exceeds the 1 MiB limit.");
        }
    }
    var bytes = Packed.uint8(total);
    var offset = 0;
    for (i in 0..Array.size(lines)) {
        var length = String.byteLength(lines[i]);
        Packed.fromString(bytes, offset, lines[i]);
        offset = offset + length;
        bytes[offset] = 10;
        offset = offset + 1;
    }
    var file = File.open(path, "wb");
    File.writeAll(file, bytes, 0, total);
    File.close(file);
}

func emitModelSource(graph, binding) {
    var plan = onnxPlanStageF(graph);
    var registry = kernelRegistryNew();
    var stepKernels = [];
    for (i in 0..Array.size(plan.steps)) {
        Array.push(stepKernels,
                   kernelRegistryResolve(registry, plan, plan.steps[i]));
    }

    var lines = [];
    sourceAppend(lines, "// Generated by onnx2noct Stage " + plan.stage +
                 ". GPU-only; do not edit.");
    sourceAppend(lines, "// normalized opset: " + graph.opset);
    sourceAppend(lines, "");
    for (i in 0..Array.size(plan.storages)) {
        var storage = plan.storages[i];
        sourceAppend(lines, "__accel var " + storage.resourceName +
                     " = Accel.float32(" + storage.elements + ");");
    }
    sourceAppend(lines, "");
    sourceAppend(lines, "var model_initialized = 0;");
    sourceAppend(lines, "var model_busy = 0;");
    sourceAppend(lines, "");
    for (i in 0..Array.size(registry.kernels)) {
        sourceAppendAll(lines, registry.kernels[i].lines);
        sourceAppend(lines, "");
    }
    if (!binding.package && Array.size(plan.weights) > 0) {
        sourceAppend(lines, "func modelPackHash(weightsPath: string) {");
        sourceAppend(lines, "    let size = FileUtil.getFileSize(weightsPath);");
        sourceAppend(lines, "    if (size <= 0 || size > 536870912) { System.error(\"Model weights file size is invalid.\"); }");
        sourceAppend(lines, "    let file = File.open(weightsPath, \"rb\");");
        sourceAppend(lines, "    let bytes = File.readExact(file, size);");
        sourceAppend(lines, "    File.close(file);");
        sourceAppend(lines, "    return Hash.sha256(bytes);");
        sourceAppend(lines, "}");
        sourceAppend(lines, "");
    }
    sourceAppend(lines, "func modelInfo() {");
    var infoLine = "    return { target: \"gpu\", stage: \"" + plan.stage +
                   "\", opset: " + graph.opset + ", inputElements: " +
                   plan.inputElements + ", outputElements: " + plan.outputElements +
                   ", inputShape: " + dumpArray(graph.tensors[graph.inputTensor].shape) +
                   ", outputShape: " + dumpArray(graph.tensors[graph.outputTensor].shape) +
                   ", kernels: " + Array.size(registry.kernels);
    if (Array.size(plan.weights) > 0) {
        infoLine = infoLine + ", weights: " + Array.size(plan.weights);
    }
    if (binding.package) {
        infoLine = infoLine + ", sourceSha256: \"" + binding.sourceHash +
                   "\", weightsSha256: \"" + binding.packHash + "\"";
    }
    sourceAppend(lines, infoLine + " };");
    sourceAppend(lines, "}");
    sourceAppend(lines, "");
    sourceAppend(lines, "func modelInitialize(weightsPath: string): void {");
    sourceAppend(lines, "    if (model_initialized != 0) { System.error(\"Model is already initialized.\"); }");
    if (binding.package) {
        sourceAppend(lines, "    if (weightsPath == \"\") { System.error(\"Model package requires an NWT1 weights file.\"); }");
        sourceAppend(lines, "    let weight_handle = Weights.open(weightsPath, \"" + binding.packHash + "\");");
        for (i in 0..Array.size(plan.weights)) {
            var packageWeight = plan.weights[i];
            sourceAppend(lines, "    let host_weight_" + i +
                         " = Weights.loadFloat32(weight_handle, " + i + ", " +
                         dumpEscape(packageWeight.tensor.diagnosticName) + ", " +
                         dumpArray(packageWeight.tensor.shape) + ");");
        }
        sourceAppend(lines, "    Weights.close(weight_handle);");
        for (i in 0..Array.size(plan.weights)) {
            var packageUpload = plan.weights[i];
            sourceAppend(lines, "    Accel.copyToAccel(host_weight_" + i +
                         ", 0, " + plan.storageById["s" + packageUpload.storageId].resourceName +
                         ", 0, " +
                         (shapeElements(packageUpload.tensor.shape, "Stage H weight") * 4) + ");");
        }
    } else if (Array.size(plan.weights) == 0) {
        sourceAppend(lines, "    if (weightsPath != \"\") { System.error(\"Stage-F pointwise model has no weights file.\"); }");
    } else {
        if (plan.stage == "G1") {
            sourceAppend(lines, "    if (weightsPath == \"\") { System.error(\"Stage-G1 Conv model requires an NWT1 weights file.\"); }");
        } else {
            sourceAppend(lines, "    if (weightsPath == \"\") { System.error(\"Stage-G2 contraction model requires an NWT1 weights file.\"); }");
        }
        sourceAppend(lines, "    let weight_handle = Weights.open(weightsPath, modelPackHash(weightsPath));");
        for (i in 0..Array.size(plan.weights)) {
            var weight = plan.weights[i];
            sourceAppend(lines, "    let host_weight_" + i +
                         " = Weights.loadFloat32(weight_handle, " + i + ", " +
                         dumpEscape(weight.tensor.diagnosticName) + ", " +
                         dumpArray(weight.tensor.shape) + ");");
        }
        sourceAppend(lines, "    Weights.close(weight_handle);");
        for (i in 0..Array.size(plan.weights)) {
            var upload = plan.weights[i];
            sourceAppend(lines, "    Accel.copyToAccel(host_weight_" + i +
                         ", 0, " + plan.storageById["s" + upload.storageId].resourceName +
                         ", 0, " +
                         (shapeElements(upload.tensor.shape, "Stage G.1 weight") * 4) + ");");
        }
    }
    sourceAppend(lines, "    model_initialized = 1;");
    sourceAppend(lines, "}");
    sourceAppend(lines, "");
    sourceAppend(lines, "func modelInfer(input: rpackedfloat, output: rpackedfloat): void {");
    sourceAppend(lines, "    if (model_initialized == 0) { System.error(\"Model is not initialized.\"); }");
    sourceAppend(lines, "    if (model_busy != 0) { System.error(\"Model inference is not reentrant.\"); }");
    sourceAppend(lines, "    if (input == output) { System.error(\"Model input and output must be distinct.\"); }");
    sourceAppend(lines, "    if (Packed.size(input) != " + plan.inputElements +
                 ") { System.error(\"Model input element count mismatch.\"); }");
    sourceAppend(lines, "    if (Packed.size(output) != " + plan.outputElements +
                 ") { System.error(\"Model output element count mismatch.\"); }");
    sourceAppend(lines, "    model_busy = 1;");
    sourceAppend(lines, "    Accel.copyToAccel(input, 0, " +
                 plan.storageById["s" + plan.inputStorage].resourceName +
                 ", 0, " + (plan.inputElements * 4) + ");");
    for (i in 0..Array.size(plan.steps)) {
        sourceAppend(lines, kernelCallLine(plan, plan.steps[i], stepKernels[i]));
    }
    sourceAppend(lines, "    Accel.copyFromAccel(" +
                 plan.storageById["s" + plan.outputStorage].resourceName +
                 ", 0, output, 0, " + (plan.outputElements * 4) + ");");
    sourceAppend(lines, "    model_busy = 0;");
    sourceAppend(lines, "}");
    sourceAppend(lines, "");
    sourceAppend(lines, "func modelWarmup(): void {");
    sourceAppend(lines, "    let warm_input = Packed.float32(" + plan.inputElements + ");");
    sourceAppend(lines, "    let warm_output = Packed.float32(" + plan.outputElements + ");");
    sourceAppend(lines, "    modelInfer(warm_input, warm_output);");
    sourceAppend(lines, "}");
    sourceAppend(lines, "");
    sourceAppend(lines, "func modelShutdown(): void {");
    sourceAppend(lines, "    model_busy = 0;");
    sourceAppend(lines, "    model_initialized = 0;");
    sourceAppend(lines, "}");
    return { lines: lines, plan: plan, registry: registry };
}

func emitStageFModel(outputDirectory, graph) {
    var emitted = emitModelSource(graph, {
        package: false, sourceHash: "", packHash: ""
    });
    FileUtil.makeDirectoryExclusive(outputDirectory);
    sourceWriteLines(outputDirectory + "/model.noct", emitted.lines);
    return emitted;
}
