msgid "%s accelerator session changed during dispatch."
msgstr "La session de l’accélérateur %s a changé pendant le lancement."

msgid "%s accelerator session changed during finish."
msgstr "La session de l’accélérateur %s a changé pendant la finalisation."

msgid "%s accelerator session changed while publishing results."
msgstr "La session de l’accélérateur %s a changé pendant la publication des résultats."

msgid "%s failed."
msgstr "Échec de %s."

msgid "%s is unavailable."
msgstr "%s n’est pas disponible."

