msgstr "%s() n’est pas définie\n"

msgid "%s() must have zero or one parameter\n"
msgstr "%s() doit avoir zéro ou un paramètre\n"

msgid "%s(): Function arguments not match."
msgstr "%s(): Les arguments de la fonction ne correspondent pas."

msgid "%s(): argument type mismatch (expected %s)."
msgstr "%s() : le type de l’argument ne correspond pas (type attendu : %s)."

msgid "%s(): local type mismatch (expected %s)."
msgstr "%s() : le type de la variable locale ne correspond pas (type attendu : %s)."

msgid "%s(): return type mismatch (expected %s)."
msgstr "%s() : le type de retour ne correspond pas (type attendu : %s)."

msgid "%s: Out of memory while parsing."
msgstr "%s: Mémoire insuffisante lors de l'analyse."

msgid "%s:%d: Error: %s\n"
msgstr "%s:%d: Erreur: %s\n"

msgid "--gpu-list may be specified only once.\n"
msgstr "--gpu-list ne peut être spécifiée qu’une seule fois.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "--gpu-list doit être utilisée seule.\n"

msgid "A __fast array index must be int or long."
msgstr "Un index de tableau __fast doit être int ou long."

msgid "A __fast assignment requires an exact type match."
msgstr "Une affectation __fast exige une correspondance exacte des types."

msgid "A __fast assignment target must be a typed local."
msgstr "La cible d’une affectation __fast doit être une variable locale typée."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Une fonction intrinsèque binaire __fast exige des opérandes de même type."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Une opération binaire __fast exige des types primitifs d’opérandes identiques."

msgid "A __fast condition must have type int."
msgstr "Une condition __fast doit être de type int."

msgid "A __fast expression is too deeply nested."
msgstr "Une expression __fast est imbriquée trop profondément."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "Une func __fast ne peut appeler directement qu’une fonction __fast ou une fonction intrinsèque."

msgid "A __fast func must declare its return type."
msgstr "Une func __fast doit déclarer son type de retour."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Un paramètre de func __fast doit être primitif ou un rpacked doté d’une forme."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "Le type de retour d’une func __fast doit être void, int, long, float ou double."

msgid "A __fast func supports only ranged for loops."
msgstr "Une func __fast ne prend en charge que les boucles for avec plage."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "Le nom d’une fonction __fast entre en conflit avec une fonction intrinsèque du compilateur."

msgid "A __fast integer operation requires int or long."
msgstr "Une opération entière __fast exige int ou long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Une fonction intrinsèque __fast exige un argument numérique typé statiquement."

msgid "A __fast logical operand must have type int."
msgstr "Un opérande logique __fast doit être de type int."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Une fonction intrinsèque numérique __fast exige des arguments numériques."

msgid "A __fast packed access is provably out of bounds."
msgstr "Il est démontrable qu’un accès packed __fast est hors limites."

msgid "A __fast packed store requires an exact element type match."
msgstr "Un stockage packed __fast exige une correspondance exacte du type d’élément."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "La forme d’un paramètre __fast comporte plus de 8 dimensions."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Une boucle avec plage __fast exige des limites correspondantes de type int ou long."

msgid "A __fast return value does not match its declared type."
msgstr "Une valeur de retour __fast ne correspond pas à son type déclaré."

msgid "A __fast shape extent must be int or long."
msgstr "L’étendue d’une forme __fast doit être int ou long."

msgid "A __fast shape extent must be positive."
msgstr "L’étendue d’une forme __fast doit être positive."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "La base d’un indice __fast doit être un paramètre rpacked doté d’une forme."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Une fonction intrinsèque transcendante __fast exige float ou double."

msgid "A __fast unary operand must be primitive."
msgstr "Un opérande unaire __fast doit être primitif."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Une fonction intrinsèque binaire __fast exige des opérandes de même type."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Un argument d’un appel direct __fast ne correspond pas au type de la fonction appelée."

msgid "A direct __fast call has the wrong argument count."
msgstr "Un appel direct __fast comporte un nombre incorrect d’arguments."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Un argument packed d’un appel direct __fast possède un type d’élément incorrect."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Un argument packed d’un appel direct __fast doit être un paramètre."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "La forme packed d’un appel direct __fast ne correspond pas à la vue de la fonction appelée."

msgid "A direct __fast call packed shape rank does not match."
msgstr "Le nombre de dimensions de la forme packed d’un appel direct __fast ne correspond pas."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Une étendue dynamique de forme __fast doit désigner un paramètre int ou long."

msgid "A function return type cannot have a shape."
msgstr "Le type de retour d’une fonction ne peut pas avoir de forme."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Une variable locale utilisée dans une func __fast doit avoir un type primitif exact."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Un indice multidimensionnel exige un paramètre doté d’une forme et nommé directement."

msgid "A non-void __fast func must return a value."
msgstr "Une func __fast non-void doit retourner une valeur."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Un paramètre primitif __fast ne peut pas avoir de forme."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Un paramètre primitif __fast doit utiliser exactement int, long, float ou double."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Un paramètre packed restreint __fast exige une forme exacte."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Un type packed restreint n’est valide que pour un paramètre."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Un paramètre __fast doté d’une forme doit être de type Packed."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Une fonction intrinsèque transcendante __fast exige float ou double."

msgid "A typed function must return a value."
msgstr "Une fonction typée doit retourner une valeur."

msgid "A void function cannot return a value."
msgstr "Une fonction void ne peut pas retourner de valeur."

msgid "Accelerator Packed argument is missing."
