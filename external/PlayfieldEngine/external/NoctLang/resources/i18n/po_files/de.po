msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "  --gc-graduate-size=N ... second GC space size in bytes\n"
msgstr "  --gc-graduate-size=N ... Größe des zweiten GC-Speicherbereichs in Byte\n"

msgid "  --gc-lop-threshold=N ... move objects larger than N-bytes to final GC space\n"
msgstr "  --gc-lop-threshold=N ... Objekte groser als N Byte in den finalen GC-Speicherbereich verschieben\n"

msgid "  --gc-nursery-size=N  ... first GC space size in bytes\n"
msgstr "  --gc-nursery-size=N  ... Größe des ersten GC-Speicherbereichs in Byte\n"

msgid "  --gc-tenure-size=N   ... final GC space size in bytes\n"
msgstr "  --gc-tenure-size=N   ... Größe des finalen GC-Speicherbereichs in Byte\n"

msgid "  --gpu-list           ... list suitable GPU device selectors\n"
msgstr "  --gpu-list           ... geeignete GPU-Geräteselektoren auflisten\n"

msgid "  --gpu[=SELECTOR]     ... use GPU acceleration for source execution\n"
msgstr "  --gpu[=SELECTOR]     ... GPU-Beschleunigung zur Ausführung des Quellcodes verwenden\n"

msgid "  --path=DIR1:DIR2     ... append source-module search paths\n"
msgstr "  --path=DIR1:DIR2     ... Suchpfade für Quellmodule anhängen\n"

msgid "  --simd-info          ... report successfully vectorized loops\n"
msgstr "  --simd-info          ... erfolgreich vektorisierte Schleifen melden\n"

msgid "  -O, -O0..-O3, -O9    ... optimization preset\n"
msgstr "  -O, -O0..-O3, -O9    ... Optimierungsvoreinstellung\n"

msgid "  -j, -j0              ... eager JIT (default), or interpreter only\n"
msgstr "  -j, -j0              ... sofortige JIT-Kompilierung (Standard) oder nur Interpreter\n"

msgid "  noct --ansic <out-file> <in-files>  ... convert to a C source file\n"
msgstr "  noct --ansic <out-file> <in-files>  ... in eine C-Quelldatei umwandeln\n"

msgid "  noct --compile <in-files>           ... convert to bytecode files\n"
msgstr "  noct --compile <in-files>           ... in Bytecode-Dateien umwandeln\n"

msgid "  noct --elisp <out-file> <in-files>  ... convert to an Emacs Lisp source file\n"
msgstr "  noct --elisp <out-file> <in-files>  ... in eine Emacs-Lisp-Quelldatei umwandeln\n"

msgid "  noct --scheme <out-file> <in-files> ... convert to an Scheme source file\n"
msgstr "  noct --scheme <out-file> <in-files> ... in eine Scheme-Quelldatei umwandeln\n"

msgid "  noct <vm-options> <files>           ... run a program\n"
msgstr "  noct <vm-options> <files>           ... ein Programm ausführen\n"

msgid "%s"
msgstr "%s"

msgid "%s\n"
msgstr "%s\n"

msgid "%s accelerator %s."
msgstr "%s-Beschleuniger %s."

msgid "%s accelerator %s: %s"
msgstr "%s-Beschleuniger %s: %s"

msgid "%s accelerator context is detached."
msgstr "Der Kontext des %s-Beschleunigers ist getrennt."

msgid "%s accelerator program changed during begin."
msgstr "Das Programm des %s-Beschleunigers wurde während des Starts geändert."

msgid "%s accelerator program is not published."
msgstr "Das Programm des %s-Beschleunigers ist nicht veröffentlicht."

msgid "%s accelerator session changed during dispatch."
msgstr "Die Sitzung des %s-Beschleunigers wurde während des Dispatch geändert."

msgid "%s accelerator session changed during finish."
msgstr "Die Sitzung des %s-Beschleunigers wurde während des Abschlusses geändert."

msgid "%s accelerator session changed while publishing results."
msgstr "Die Sitzung des %s-Beschleunigers wurde während der Veröffentlichung der Ergebnisse geändert."

msgid "%s failed."
msgstr "%s ist fehlgeschlagen."

msgid "%s is unavailable."
msgstr "%s ist nicht verfügbar."

msgid "%s() is not defined\n"
msgstr "%s() ist nicht definiert\n"

msgid "%s() must have zero or one parameter\n"
msgstr "%s() muss null oder einen Parameter haben\n"

msgid "%s(): Function arguments not match."
msgstr "%s(): Die Funktionsargumente stimmen nicht überein."

msgid "%s(): argument type mismatch (expected %s)."
msgstr "%s(): Argumenttyp stimmt nicht überein (%s erwartet)."

msgid "%s(): local type mismatch (expected %s)."
msgstr "%s(): Typ der lokalen Variable stimmt nicht überein (%s erwartet)."

msgid "%s(): return type mismatch (expected %s)."
msgstr "%s(): Rückgabetyp stimmt nicht überein (%s erwartet)."

msgid "%s: Out of memory while parsing."
msgstr "%s: Nicht genügend Speicher beim Parsen."

msgid "%s:%d: Error: %s\n"
msgstr "%s:%d: Fehler: %s\n"

msgid "--gpu-list may be specified only once.\n"
msgstr "--gpu-list darf nur einmal angegeben werden.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "--gpu-list muss allein verwendet werden.\n"

msgid "A __fast array index must be int or long."
msgstr "Ein __fast-Array-Index muss int oder long sein."

msgid "A __fast assignment requires an exact type match."
msgstr "Eine __fast-Zuweisung erfordert eine exakte Typübereinstimmung."

msgid "A __fast assignment target must be a typed local."
msgstr "Das Ziel einer __fast-Zuweisung muss eine typisierte lokale Variable sein."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Eine binäre intrinsische __fast-Funktion erfordert Operanden desselben Typs."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Eine binäre __fast-Operation erfordert identische primitive Operandentypen."

msgid "A __fast condition must have type int."
msgstr "Eine __fast-Bedingung muss den Typ int haben."

msgid "A __fast expression is too deeply nested."
msgstr "Ein __fast-Ausdruck ist zu tief verschachtelt."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "Eine __fast-func darf nur eine direkte __fast-Funktion oder eine intrinsische Funktion aufrufen."

msgid "A __fast func must declare its return type."
msgstr "Eine __fast-func muss ihren Rückgabetyp deklarieren."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Ein Parameter einer __fast-func muss primitiv oder ein rpacked mit Form sein."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "Der Rückgabetyp einer __fast-func muss void, int, long, float oder double sein."

msgid "A __fast func supports only ranged for loops."
msgstr "Eine __fast-func unterstützt nur bereichsgebundene for-Schleifen."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "Der Name einer __fast-Funktion steht im Konflikt mit einer intrinsischen Compiler-Funktion."

msgid "A __fast integer operation requires int or long."
msgstr "Eine ganzzahlige __fast-Operation erfordert int oder long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Eine intrinsische __fast-Funktion erfordert ein statisch typisiertes numerisches Argument."

msgid "A __fast logical operand must have type int."
msgstr "Ein logischer __fast-Operand muss den Typ int haben."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Eine numerische intrinsische __fast-Funktion erfordert numerische Argumente."

msgid "A __fast packed access is provably out of bounds."
msgstr "Ein packed-Zugriff in __fast liegt nachweislich außerhalb der Grenzen."

msgid "A __fast packed store requires an exact element type match."
msgstr "Ein packed-Speichervorgang in __fast erfordert eine exakte Übereinstimmung des Elementtyps."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "Die Form eines __fast-Parameters hat mehr als 8 Dimensionen."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Eine bereichsgebundene __fast-Schleife erfordert übereinstimmende Grenzen vom Typ int oder long."

msgid "A __fast return value does not match its declared type."
msgstr "Ein __fast-Rückgabewert entspricht nicht seinem deklarierten Typ."

msgid "A __fast shape extent must be int or long."
msgstr "Die Ausdehnung einer __fast-Form muss int oder long sein."

msgid "A __fast shape extent must be positive."
msgstr "Die Ausdehnung einer __fast-Form muss positiv sein."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "Die Basis eines __fast-Indexausdrucks muss ein rpacked-Parameter mit Form sein."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Eine transzendente intrinsische __fast-Funktion erfordert float oder double."

msgid "A __fast unary operand must be primitive."
msgstr "Ein unärer __fast-Operand muss primitiv sein."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Eine binäre intrinsische __fast-Funktion erfordert Operanden desselben Typs."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Ein Argument eines direkten __fast-Aufrufs entspricht nicht dem Typ der aufgerufenen Funktion."

msgid "A direct __fast call has the wrong argument count."
msgstr "Ein direkter __fast-Aufruf hat die falsche Anzahl von Argumenten."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Ein packed-Argument eines direkten __fast-Aufrufs hat den falschen Elementtyp."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Ein packed-Argument eines direkten __fast-Aufrufs muss ein Parameter sein."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "Die packed-Form eines direkten __fast-Aufrufs entspricht nicht der Ansicht der aufgerufenen Funktion."

msgid "A direct __fast call packed shape rank does not match."
msgstr "Die Dimensionsanzahl der packed-Form eines direkten __fast-Aufrufs stimmt nicht überein."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Eine dynamische Ausdehnung einer __fast-Form muss einen int- oder long-Parameter benennen."

msgid "A function return type cannot have a shape."
msgstr "Der Rückgabetyp einer Funktion darf keine Form haben."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Eine in einer __fast-func verwendete lokale Variable muss einen exakten primitiven Typ haben."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Ein mehrdimensionaler Indexausdruck erfordert einen direkt benannten Parameter mit Form."

msgid "A non-void __fast func must return a value."
msgstr "Eine __fast-func mit einem anderen Rückgabetyp als void muss einen Wert zurückgeben."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Ein primitiver __fast-Parameter darf keine Form haben."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Ein primitiver __fast-Parameter muss exakt int, long, float oder double verwenden."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Ein eingeschränkter packed-Parameter in __fast erfordert eine exakte Form."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Ein eingeschränkter packed-Typ ist nur für einen Parameter gültig."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Ein __fast-Parameter mit Form muss ein Packed-Typ sein."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Eine transzendente intrinsische __fast-Funktion erfordert float oder double."

msgid "A typed function must return a value."
msgstr "Eine typisierte Funktion muss einen Wert zurückgeben."

msgid "A void function cannot return a value."
msgstr "Eine void-Funktion darf keinen Wert zurückgeben."

msgid "Accelerator Packed argument is missing."
msgstr "Das Packed-Argument des Beschleunigers fehlt."

msgid "Accelerator Packed element type does not match."
msgstr "Der Packed-Elementtyp des Beschleunigers stimmt nicht überein."

msgid "Accelerator VM and environment do not match."
msgstr "Beschleuniger-VM und Umgebung stimmen nicht überein."

msgid "Accelerator access has an invalid effect."
msgstr "Der Beschleunigerzugriff hat einen ungültigen Effekt."

msgid "Accelerator access has no buffer binding."
msgstr "Der Beschleunigerzugriff hat keine Pufferbindung."

msgid "Accelerator access references an unknown buffer."
msgstr "Der Beschleunigerzugriff verweist auf einen unbekannten Puffer."

msgid "Accelerator argument count changed."
msgstr "Die Anzahl der Beschleunigerargumente hat sich geändert."

msgid "Accelerator argument count is too large."
msgstr "Die Anzahl der Beschleunigerargumente ist zu groß."

msgid "Accelerator backend failed to prepare a program."
msgstr "Das Beschleuniger-Backend konnte kein Programm vorbereiten."

msgid "Accelerator backend returned no program."
msgstr "Das Beschleuniger-Backend hat kein Programm zurückgegeben."

msgid "Accelerator buffer access is out of range."
msgstr "Der Zugriff auf den Beschleunigerpuffer liegt außerhalb des Bereichs."

msgid "Accelerator buffer has no required range."
msgstr "Der Beschleunigerpuffer hat nicht den erforderlichen Bereich."

msgid "Accelerator buffer has no runtime argument slot."
msgstr "Der Beschleunigerpuffer hat keinen Laufzeitargument-Slot."

msgid "Accelerator buffer range overflowed."
msgstr "Der Bereich des Beschleunigerpuffers ist übergelaufen."

msgid "Accelerator buffer size overflowed."
msgstr "Die Größe des Beschleunigerpuffers ist übergelaufen."

msgid "Accelerator context is unavailable."
msgstr "Der Beschleunigerkontext ist nicht verfügbar."

msgid "Accelerator context reference limit reached."
msgstr "Die Referenzgrenze des Beschleunigerkontexts wurde erreicht."

msgid "Accelerator device buffer is read before definition."
msgstr "Der Gerätepuffer des Beschleunigers wird vor seiner Definition gelesen."

msgid "Accelerator device buffer size is not positive."
msgstr "Die Größe des Gerätepuffers des Beschleunigers ist nicht positiv."

msgid "Accelerator device buffer size is too large."
msgstr "Die Größe des Gerätepuffers des Beschleunigers ist zu groß."

msgid "Accelerator device buffer size overflowed."
msgstr "Die Größe des Gerätepuffers des Beschleunigers ist übergelaufen."

msgid "Accelerator device-list visitor failed."
msgstr "Der Besucher der Beschleuniger-Geräteliste ist fehlgeschlagen."

msgid "Accelerator dispatch range is too large."
msgstr "Der Dispatch-Bereich des Beschleunigers ist zu groß."

msgid "Accelerator function is not registered in the HIR table."
msgstr "Die Beschleunigerfunktion ist nicht in der HIR-Tabelle registriert."

msgid "Accelerator load has no buffer binding."
msgstr "Der Ladevorgang des Beschleunigers hat keine Pufferbindung."

msgid "Accelerator local name collision."
msgstr "Namenskollision bei lokalen Variablen des Beschleunigers."

msgid "Accelerator local name is too long."
msgstr "Der Name der lokalen Beschleunigervariable ist zu lang."

msgid "Accelerator loop start overflowed."
msgstr "Der Schleifenanfang des Beschleunigers ist übergelaufen."

msgid "Accelerator output argument is missing."
msgstr "Das Ausgabeargument des Beschleunigers fehlt."

msgid "Accelerator output size changed."
msgstr "Die Größe der Beschleunigerausgabe hat sich geändert."

msgid "Accelerator output snapshot is missing."
msgstr "Die Ausgabemomentaufnahme des Beschleunigers fehlt."

msgid "Accelerator output type changed."
