// Bounded protobuf cursor for the ONNX converter. Wire types 0, 1, 2, and 5.

let PB_MAX_FILE_BYTES = 536870912;
let PB_MAX_DEPTH = 32;
let PB_MAX_STRING_BYTES = 1048576;
let PB_MAX_OBJECTS = 1000000;

func pbFail(cursor, message) {
    var at = 0;
    if (cursor != 0 && Dict.hasKey(cursor, "pos")) {
        at = cursor.pos;
    }
    System.error("ONNX protobuf at byte " + at + ": " + message);
}

func pbNewRoot(bytes) {
    var size = Packed.size(bytes);
    if (size <= 0) {
        System.error("ONNX protobuf: input file is empty.");
    }
    if (size > PB_MAX_FILE_BYTES) {
        System.error("ONNX protobuf: input exceeds the 512 MiB limit.");
    }
    return {
        bytes: bytes,
        pos: 0,
        limit: size,
        depth: 0,
        state: { objects: 0 }
    };
}

func pbCountObject(cursor, kind) {
    cursor.state.objects = cursor.state.objects + 1;
    if (cursor.state.objects > PB_MAX_OBJECTS) {
        pbFail(cursor, "decoded object limit exceeded while reading " + kind + ".");
    }
}

func pbNeed(cursor, count, what) {
    if (count < 0 || cursor.pos > cursor.limit || count > cursor.limit - cursor.pos) {
        pbFail(cursor, "truncated " + what + ".");
    }
}

func pbReadVarint(cursor) {
    var value = Binary.readVarintUnsigned(cursor.bytes, cursor.pos, cursor.limit);
    cursor.pos = Binary.skipVarint(cursor.bytes, cursor.pos, cursor.limit);
    return value;
}

func pbReadSignedVarint(cursor) {
    var value = Binary.readVarintSigned(cursor.bytes, cursor.pos, cursor.limit);
    cursor.pos = Binary.skipVarint(cursor.bytes, cursor.pos, cursor.limit);
    return value;
}

func pbReadKey(cursor) {
    var key = pbReadVarint(cursor);
    if (key <= 0) {
        pbFail(cursor, "field number zero is invalid.");
    }
    var wire = key & 7;
    var field = key >> 3;
    if (field <= 0) {
        pbFail(cursor, "field number zero is invalid.");
    }
    if (wire != 0 && wire != 1 && wire != 2 && wire != 5) {
        pbFail(cursor, "unsupported wire type " + wire + ".");
    }
    return { field: field, wire: wire };
}

func pbExpectWire(cursor, key, expected, fieldName) {
    if (key.wire != expected) {
        pbFail(cursor, fieldName + " has wire type " + key.wire +
               ", expected " + expected + ".");
    }
}

func pbReadSlice(cursor, fieldName) {
    var length = pbReadVarint(cursor);
    if (length < 0) {
        pbFail(cursor, fieldName + " length exceeds the supported range.");
    }
    pbNeed(cursor, length, fieldName);
    var child = {
        bytes: cursor.bytes,
        pos: cursor.pos,
        limit: cursor.pos + length,
        depth: cursor.depth,
        state: cursor.state
    };
    cursor.pos = cursor.pos + length;
    return child;
}

func pbReadChild(cursor, fieldName) {
    if (cursor.depth + 1 > PB_MAX_DEPTH) {
        pbFail(cursor, "message nesting exceeds 32.");
    }
    var child = pbReadSlice(cursor, fieldName);
    child.depth = cursor.depth + 1;
    return child;
}

func pbFinish(cursor, messageName) {
    if (cursor.pos != cursor.limit) {
        pbFail(cursor, messageName + " child cursor did not end exactly.");
    }
}

func pbUtf8Continuation(value) {
    return value >= 128 && value <= 191;
}

func pbUtf8Valid(bytes, offset, length) {
    var pos = offset;
    var limit = offset + length;
    while (pos < limit) {
        var first = bytes[pos];
        if (first <= 127) {
            pos = pos + 1;
        } else if (first >= 194 && first <= 223) {
            if (pos + 1 >= limit || !pbUtf8Continuation(bytes[pos + 1])) {
                return false;
            }
            pos = pos + 2;
        } else if (first >= 224 && first <= 239) {
            if (pos + 2 >= limit || !pbUtf8Continuation(bytes[pos + 2])) {
                return false;
            }
            var second = bytes[pos + 1];
            if ((first == 224 && (second < 160 || second > 191)) ||
                (first == 237 && (second < 128 || second > 159)) ||
                (first != 224 && first != 237 &&
                 !pbUtf8Continuation(second))) {
                return false;
            }
            pos = pos + 3;
        } else if (first >= 240 && first <= 244) {
            if (pos + 3 >= limit ||
                !pbUtf8Continuation(bytes[pos + 2]) ||
                !pbUtf8Continuation(bytes[pos + 3])) {
                return false;
            }
            var second4 = bytes[pos + 1];
            if ((first == 240 && (second4 < 144 || second4 > 191)) ||
                (first == 244 && (second4 < 128 || second4 > 143)) ||
                (first != 240 && first != 244 &&
                 !pbUtf8Continuation(second4))) {
                return false;
            }
            pos = pos + 4;
        } else {
            return false;
        }
    }
    return true;
}

func pbReadString(cursor, fieldName) {
    var child = pbReadSlice(cursor, fieldName);
    var length = child.limit - child.pos;
    if (length > PB_MAX_STRING_BYTES) {
        pbFail(child, fieldName + " exceeds the 1 MiB string limit.");
    }
    for (i in child.pos..child.limit) {
        if (child.bytes[i] == 0) {
            pbFail(child, fieldName + " contains a NUL byte.");
        }
    }
    if (!pbUtf8Valid(child.bytes, child.pos, length)) {
        pbFail(child, fieldName + " is not valid UTF-8.");
    }
    var result = Packed.toString(child.bytes, child.pos, length);
    child.pos = child.limit;
    return result;
}

func pbReadBytesView(cursor, fieldName) {
    var child = pbReadSlice(cursor, fieldName);
    return {
        bytes: child.bytes,
        offset: child.pos,
        length: child.limit - child.pos
    };
}

func pbReadFixed32(cursor, fieldName) {
    pbNeed(cursor, 4, fieldName);
    var value = Binary.readU32LE(cursor.bytes, cursor.pos);
    cursor.pos = cursor.pos + 4;
    return value;
}

func pbReadFixed64(cursor, fieldName) {
    pbNeed(cursor, 8, fieldName);
    var value = Binary.readI64LE(cursor.bytes, cursor.pos);
    cursor.pos = cursor.pos + 8;
    return value;
}

func pbSkipField(cursor, wire, fieldName) {
    if (wire == 0) {
        pbReadVarint(cursor);
    } else if (wire == 1) {
        pbNeed(cursor, 8, fieldName);
        cursor.pos = cursor.pos + 8;
    } else if (wire == 2) {
        var child = pbReadSlice(cursor, fieldName);
        child.pos = child.limit;
    } else if (wire == 5) {
        pbNeed(cursor, 4, fieldName);
        cursor.pos = cursor.pos + 4;
    } else {
        pbFail(cursor, "unsupported wire type " + wire + ".");
    }
}
