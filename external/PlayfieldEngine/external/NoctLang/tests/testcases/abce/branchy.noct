func main() {
    var n = 1000;
    var p = Packed.uint8(n);
    for (i in 0..n) {
        p[i] = (i * 7) % 256;
    }
    var lead = 0;
    var count = 0;
    for (i in 0..n) {
        lead = p[i];
        if (lead < 128) {
            count = count + 1;
        } else if (lead < 192) {
            count = count + 2;
        } else {
            count = count + 3;
        }
    }
    print(count);
}
