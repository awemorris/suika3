func side() {
    print("side");
    return 1;
}
func main() {
    var d = { k: 4 };
    var n = 1;
    var a = (n > 100) && (d.k * 6 + d.k * 6 > 0);
    print(a);
    var b = d.k * 6;
    print(b);
