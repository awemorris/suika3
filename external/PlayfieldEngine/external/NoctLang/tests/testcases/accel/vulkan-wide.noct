__accel func add_bias(
    input: rpackeduint32_in,
    output: rpackeduint32_out,
    count: int,
    bias: int
): void {
    for (i in 0..count) {
        output[i] = input[i] + bias;
    }
}

func main() {
    let input = Packed.uint32(130);
    let output = Packed.uint32(130);
    for (i in 0..130) {
        input[i] = i;
    }
    Accel.call(add_bias, input, output, 130, 7);
    print(output[0]);
    print(output[63]);
    print(output[64]);
    print(output[129]);
}
