__accel var device = Accel.uint32(4);

__gpu func bump(data: rpackeduint32_ptr, count: int): void {
    let i: int = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < count) {
        data[i] = data[i] + 1;
    }
}

func main() {
    let source = Packed.uint32(4);
    let result = Packed.uint32(4);
    source[0] = 10;
    source[3] = 40;
    Accel.copyToAccel(source, 0, device, 0, 16);
    bump<<<1, 4>>>(device, 4);
    Accel.copyFromAccel(device, 0, result, 0, 16);
    print(result[0]);
    print(result[3]);
}
