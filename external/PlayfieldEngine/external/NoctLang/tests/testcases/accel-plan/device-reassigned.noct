__accel func transform(
    source: rpackedint32,
    destination: rpackedint32,
    n: int): void {
    var temporary: packedint32 = Packed.int32(n);
    for (i in 0..n) {
        temporary[i] = source[i] * 3;
    }
    for (j in 0..n) {
        destination[j] = temporary[j] + 1;
    }
    temporary = Packed.int32(n);
}

func main() {
}
