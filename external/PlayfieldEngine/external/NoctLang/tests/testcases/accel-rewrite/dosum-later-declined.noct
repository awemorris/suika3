__accel func reduce(
    source: rpackedint32,
    destination: rpackedint32,
    float_source: rpackedfloat,
    float_destination: rpackedfloat,
    n: int): void {
    var sum: int = 0;
    for (i in 0..n) {
        sum += source[i];
    }
    destination[0] = sum;
    for (j in 0..n) {
        float_destination[j] = -float_source[j];
    }
}

func main() {
}
