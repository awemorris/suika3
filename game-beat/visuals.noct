// Pop-art presentation. Gameplay and hit timing live in main.ray.
var ui = {};
var particles = [];
var particleCursor = 0;

func initVisuals() {
    for (name in ["background", "lanes", "pad-coral", "pad-mint", "pad-peach",
                  "note", "button", "button-light", "panel", "pill", "star", "seed",
                  "glow", "perfect", "good", "miss", "combo", "finish", "full-combo", "wordmark"]) {
        ui[name] = Engine.loadTexture({file: "assets/ui/" + name + ".png"});
    }
    for (i in 0..10) ui["digit-" + i] = Engine.loadTexture({file: "assets/ui/digit-" + i + ".png"});
    for (i in 0..32) particles[i] = {life: 0.0, x: 0.0, y: 0.0, vx: 0.0, vy: 0.0, size: 0.0, star: false};
}

func clearParticles() {
    for (p in particles) p.life = 0.0;
}

func spawnBurst(lane, big) {
    var count = 3;
    if (big) count = 14;
    for (i in 0..count) {
        var p = particles[particleCursor];
        particleCursor = (particleCursor + 1) % 32;
        var direction = (i * 2.39996 + worldTime) + lane;
        var speed = 45.0 + (i % 4) * 13;
        if (big) speed = speed * 1.7;
        p.x = 225 + Math.cos(direction) * 73;
        p.y = 300 + Math.sin(direction) * 72;
        p.vx = Math.cos(direction) * speed;
        p.vy = Math.sin(direction) * speed - 55;
        p.life = 0.9 + (i % 3) * 0.1;
        p.size = 10 + (i % 3) * 5;
        p.star = big || i % 2 == 0;
    }
}

func updateParticles(dt) {
    var step = clamp(dt, 0.0, 0.08);
    for (p in particles) {
        if (p.life > 0.0) {
            p.life = p.life - dt;
            p.x = p.x + p.vx * step;
            p.y = p.y + p.vy * step;
            p.vy = p.vy + 105 * step;
        }
    }
}

func drawParticles() {
    for (p in particles) {
        if (p.life > 0.0) {
            var texture = ui.seed;
            if (p.star) texture = ui.star;
            rect(texture, p.x - p.size / 2, p.y - p.size / 2,
                 p.size, p.size, clamp(p.life * 500, 0, 255));
        }
    }
}

func drawLogo(centerY, size, alpha) {
    var rotation = angle + Math.sin(worldTime * 1.2) * 0.035;
    var half = size * (1.0 + clamp(pulse, -0.1, 0.25)) / 2.0;
    var c = Math.cos(rotation) * half;
    var s = Math.sin(rotation) * half;
    var cy = centerY + Math.sin(worldTime * 2.1) * 7.0 + lift;
    Engine.renderTexture3D({texture: logo,
        x1: (225 - c + s) * uiScale, y1: (cy - s - c) * uiScale,
        x2: (225 + c + s) * uiScale, y2: (cy + s - c) * uiScale,
        x3: (225 - c - s) * uiScale, y3: (cy - s + c) * uiScale,
        x4: (225 + c - s) * uiScale, y4: (cy + s + c) * uiScale,
        srcLeft: 0, srcTop: 0, srcWidth: logo.width, srcHeight: logo.height, alpha: alpha});
}

func drawPads() {
    var names = ["pad-coral", "pad-mint", "pad-peach"];
    for (lane in 0..3) {
        var x = 20 + lane * 134;
        // The pad compresses; its white timing line stays fixed.
        var press = flashes[lane] * 4.0;
        rect(ui[names[lane]], x, 680 + press, 134, 105 - press, 255);
        rect(ui.glow, x, 668, 134, 70, flashes[lane] * 240);
        rect(white, x + 16, 699, 102, 3, 245);
        if (flashes[lane] > 0.2) {
            rect(ui.star, x + 54, 666 - (1.0 - flashes[lane]) * 23, 25, 25, flashes[lane] * 255);
        }
    }
}

func comboDigits(value, y, size) {
    var str = "" + value;
    var count = String.charCount(str);
    var x = 225 - count * size * 0.34;
    for (i in 0..count) {
        rect(ui["digit-" + String.charAt(str, i)], x + i * size * 0.68, y, size * 0.75, size * 1.1, 255);
    }
}

func timeLabel(t) {
    var seconds = Int.from(clamp(t, 0, songLength));
    if (seconds < 10) return "0:0" + seconds;
    return "0:" + seconds;
}

func drawHUD() {
    label("SCORE", 13, 26, 15, false);
    number(score, 37, 25, 32, false);
    rect(ui.pill, 263, 19, 163, 36, 255);
    label("START / POP MIX", 12, 344, 29, true);
    label(timeLabel(songTime) + " / 0:34", 12, 283, 63, true);
    label("TITLE", 12, 390, 63, true);
    rect(faint, 25, 86, 400, 7, 180);
    rect(mint, 25, 86, 400 * clamp(songTime / songLength, 0, 1), 7, 255);
    if (screen == "playing") label(sections[sectionIndex].name, 12, 225, 109, true);
}

func render() {
    rect(ui.background, 0, 0, 450, 800, 255);
    if (screen == "title") {
        rect(ui.pill, 142, 40, 166, 36, 255);
        label("FRUIT POP RHYTHM", 12, 225, 50, true);
        rect(ui.wordmark, 45, 104, 360, 70, 255);
        drawLogo(321, 248, 255);
        rect(ui.star, 89, 254 + Math.sin(worldTime) * 8, 32, 32, 255);
        rect(ui.star, 331, 361 + Math.sin(worldTime + 1) * 8, 24, 24, 255);
        label("A LITTLE RHYTHM. A BIG SMILE.", 15, 225, 463, true);
        button("PLAY!", 520, true);
        label("MUSIC", 12, 225, 590, true);
        label("-", 23, 125, 615, true);
        label("+", 23, 325, 615, true);
        number(Int.from(volume * 100 + 0.5), 18, 225, 618, true);
        label("TIMING OFFSET", 12, 225, 663, true);
        label("-", 23, 112, 686, true);
        label("+", 23, 338, 686, true);
        number(timingOffsetMs, 18, 215, 691, true);
        label("ms", 12, 256, 695, false);
        label("34 SEC  /  120 BPM  /  D  F  J", 13, 225, 740, true);
        return;
    }
    if (screen == "results") {
        label("TITLE", 13, 388, 34, true);
        label("SWEET SESSION!", 25, 225, 76, true);
        drawLogo(223, 194, 255);
        drawParticles();
        rect(ui.panel, 45, 329, 360, 281, 255);
        if (misses == 0) rect(ui["full-combo"], 45, 331, 360, 70, 255);
        else label("NICE PLAY!", 24, 225, 351, true);
        number(score, 43, 225, 401, true);
        label("MAX COMBO", 15, 73, 472, false);
        number(maxCombo, 21, 350, 465, true);
        label("PERFECT", 12, 118, 511, true);
        label("GOOD", 12, 228, 511, true);
        label("MISS", 12, 335, 511, true);
        number(perfect, 23, 118, 533, true);
        number(good, 23, 228, 533, true);
        number(misses, 23, 335, 533, true);
        label("SESSION BEST", 12, 99, 579, false);
        number(best, 17, 312, 575, true);
        button("PLAY AGAIN", 620, true);
        button("TITLE", 694, false);
        return;
    }
    if (screen == "tutorial") {
        label("TITLE", 13, 388, 34, true);
        label("FEEL THE BEAT", 27, 225, 95, true);
        drawLogo(276, 197, 255);
        drawParticles();
        label("Tap when a note meets the white line.", 18, 225, 416, true);
        label("Try the three pads!", 18, 225, 455, true);
        for (lane in 0..3) {
            if (practiced[lane]) rect(ui.star, 74 + lane * 134, 506, 26, 26, 255);
        }
        button("LET'S PLAY", 560, true);
        label("D                    F                    J", 12, 225, 648, true);
        drawPads();
        return;
    }
    rect(ui.lanes, 0, 0, 450, 800, 255);
    drawHUD();
    drawLogo(305, 229, 240);
    drawParticles();
    if (combo > 0) {
        var bounce = 1.0 + flashes[0] * 0.025 + flashes[1] * 0.025 + flashes[2] * 0.025;
        comboDigits(combo, 424, 66 * bounce);
        label("COMBO", 20, 225, 499, true);
    }
    drawPads();
    if (Engine.millisec < feedbackUntil) {
        var name = "perfect";
        if (feedback == "GOOD") name = "good";
        if (feedback == "MISS") name = "miss";
        if (feedback == "COMBO!") name = "combo";
        var remaining = (feedbackUntil - Engine.millisec) / 480.0;
        // Transient lettering stays behind notes so judgment remains readable.
        rect(ui[name], 77, 598 - remaining * 4, 296, 58, clamp(remaining * 650, 0, 255));
    }
    // Opaque notes are always above mascot, particles, pads and feedback.
    if (screen == "playing") {
        for (i in nextMiss..noteCount) {
            if (chart[i].time - songTime > approach) break;
            if (!judged[i]) {
                var y = 701 - (chart[i].time - songTime) * 551 / approach;
                if (y >= 147 && y <= 755) {
                    rect(ui.note, 32 + chart[i].lane * 134, y - 21, 110, 46, 255);
                }
            }
        }
    }
    if (screen == "countdown") {
        rect(ui.panel, 123, 414, 204, 144, 245);
        label("READY?", 18, 225, 431, true);
        comboDigits(3 - Int.from((Engine.millisec - screenTime) / 1000), 463, 67);
    }
    if (screen == "finish") rect(ui.finish, 45, 432, 360, 70, 255);
}
