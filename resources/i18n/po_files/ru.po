msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "  --gc-graduate-size=N ... second GC space size in bytes\n"
msgstr "  --gc-graduate-size=N ... размер второй области GC в байтах\n"

msgid "  --gc-lop-threshold=N ... move objects larger than N-bytes to final GC space\n"
msgstr "  --gc-lop-threshold=N ... перемещать объекты больше N байт в финальную область GC\n"

msgid "  --gc-nursery-size=N  ... first GC space size in bytes\n"
msgstr "  --gc-nursery-size=N  ... размер первой области GC в байтах\n"

msgid "  --gc-tenure-size=N   ... final GC space size in bytes\n"
msgstr "  --gc-tenure-size=N   ... размер финальной области GC в байтах\n"

msgid "  --gpu-list           ... list suitable GPU device selectors\n"
msgstr "  --gpu-list           ... вывести подходящие селекторы устройств GPU\n"

msgid "  --gpu[=SELECTOR]     ... use GPU acceleration for source execution\n"
msgstr "  --gpu[=SELECTOR]     ... использовать ускорение GPU для выполнения исходного кода\n"

msgid "  --path=DIR1:DIR2     ... append source-module search paths\n"
msgstr "  --path=DIR1:DIR2     ... добавить пути поиска исходных модулей\n"

msgid "  --simd-info          ... report successfully vectorized loops\n"
msgstr "  --simd-info          ... сообщить об успешно векторизованных циклах\n"

msgid "  -O, -O0..-O3, -O9    ... optimization preset\n"
msgstr "  -O, -O0..-O3, -O9    ... предустановка оптимизации\n"

msgid "  -j, -j0              ... eager JIT (default), or interpreter only\n"
msgstr "  -j, -j0              ... немедленная JIT-компиляция (по умолчанию) или только интерпретатор\n"

msgid "  noct --ansic <out-file> <in-files>  ... convert to a C source file\n"
msgstr "  noct --ansic <out-file> <in-files>  ... преобразовать в исходный файл C\n"

msgid "  noct --compile <in-files>           ... convert to bytecode files\n"
msgstr "  noct --compile <in-files>           ... преобразовать в байткод-файлы\n"

msgid "  noct --elisp <out-file> <in-files>  ... convert to an Emacs Lisp source file\n"
msgstr "  noct --elisp <out-file> <in-files>  ... преобразовать в исходный файл Emacs Lisp\n"

msgid "  noct --scheme <out-file> <in-files> ... convert to an Scheme source file\n"
msgstr "  noct --scheme <out-file> <in-files> ... преобразовать в исходный файл Scheme\n"

msgid "  noct <vm-options> <files>           ... run a program\n"
msgstr "  noct <vm-options> <files>           ... запуск программы\n"

msgid "%s"
msgstr "%s"

msgid "%s\n"
msgstr "%s\n"

msgid "%s accelerator %s."
msgstr "Ускоритель %s %s."

msgid "%s accelerator %s: %s"
msgstr "Ускоритель %s %s: %s"

msgid "%s accelerator context is detached."
msgstr "Контекст ускорителя %s отсоединён."

msgid "%s accelerator program changed during begin."
msgstr "Программа ускорителя %s изменилась во время запуска."

msgid "%s accelerator program is not published."
msgstr "Программа ускорителя %s не опубликована."

msgid "%s accelerator session changed during dispatch."
msgstr "Сеанс ускорителя %s изменился во время диспетчеризации."

msgid "%s accelerator session changed during finish."
msgstr "Сеанс ускорителя %s изменился во время завершения."

msgid "%s accelerator session changed while publishing results."
msgstr "Сеанс ускорителя %s изменился во время публикации результатов."

msgid "%s failed."
msgstr "Сбой %s."

msgid "%s is unavailable."
msgstr "%s недоступен."

msgid "%s() is not defined\n"
msgstr "%s() не определена\n"

msgid "%s() must have zero or one parameter\n"
msgstr "%s() должна иметь ноль или один параметр\n"

msgid "%s(): Function arguments not match."
msgstr "%s(): Аргументы функции не совпадают."

msgid "%s(): argument type mismatch (expected %s)."
msgstr "%s(): несоответствие типа аргумента (ожидался %s)."

msgid "%s(): local type mismatch (expected %s)."
msgstr "%s(): несоответствие типа локальной переменной (ожидался %s)."

msgid "%s(): return type mismatch (expected %s)."
msgstr "%s(): несоответствие возвращаемого типа (ожидался %s)."

msgid "%s: Out of memory while parsing."
msgstr "%s: Недостаточно памяти при разборе."

msgid "%s:%d: Error: %s\n"
msgstr "%s:%d: Ошибка: %s\n"

msgid "--gpu-list may be specified only once.\n"
msgstr "Параметр --gpu-list можно указать только один раз.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "Параметр --gpu-list должен использоваться отдельно.\n"

msgid "A __fast array index must be int or long."
msgstr "Индекс массива __fast должен иметь тип int или long."

msgid "A __fast assignment requires an exact type match."
msgstr "Присваивание __fast требует точного совпадения типов."

msgid "A __fast assignment target must be a typed local."
msgstr "Цель присваивания __fast должна быть типизированной локальной переменной."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Бинарная встроенная функция __fast требует операнды одного типа."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Бинарная операция __fast требует одинаковые примитивные типы операндов."

msgid "A __fast condition must have type int."
msgstr "Условие __fast должно иметь тип int."

msgid "A __fast expression is too deeply nested."
msgstr "Выражение __fast имеет слишком большую глубину вложенности."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "func __fast может напрямую вызывать только функцию __fast или встроенную функцию."

msgid "A __fast func must declare its return type."
msgstr "func __fast должна объявлять возвращаемый тип."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Параметр func __fast должен быть примитивным или rpacked с формой."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "Возвращаемый тип func __fast должен быть void, int, long, float или double."

msgid "A __fast func supports only ranged for loops."
msgstr "func __fast поддерживает только циклы for с диапазоном."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "Имя функции __fast конфликтует со встроенной функцией компилятора."

msgid "A __fast integer operation requires int or long."
msgstr "Целочисленная операция __fast требует тип int или long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Встроенная функция __fast требует числовой аргумент со статическим типом."

msgid "A __fast logical operand must have type int."
msgstr "Логический операнд __fast должен иметь тип int."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Числовая встроенная функция __fast требует числовые аргументы."

msgid "A __fast packed access is provably out of bounds."
msgstr "Доказано, что доступ __fast к packed выходит за границы."

msgid "A __fast packed store requires an exact element type match."
msgstr "Запись __fast в packed требует точного совпадения типа элемента."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "Форма параметра __fast имеет более 8 измерений."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Цикл __fast с диапазоном требует совпадающие границы типа int или long."

msgid "A __fast return value does not match its declared type."
msgstr "Возвращаемое значение __fast не соответствует объявленному типу."

msgid "A __fast shape extent must be int or long."
msgstr "Размер измерения формы __fast должен иметь тип int или long."

msgid "A __fast shape extent must be positive."
msgstr "Размер измерения формы __fast должен быть положительным."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "Основание индекса __fast должно быть параметром rpacked с формой."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Трансцендентная встроенная функция __fast требует тип float или double."

msgid "A __fast unary operand must be primitive."
msgstr "Унарный операнд __fast должен иметь примитивный тип."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Бинарная встроенная функция __fast требует операнды одного типа."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Аргумент прямого вызова __fast не соответствует типу вызываемой функции."

msgid "A direct __fast call has the wrong argument count."
msgstr "Прямой вызов __fast содержит неверное количество аргументов."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Аргумент packed прямого вызова __fast имеет неверный тип элемента."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Аргумент packed прямого вызова __fast должен быть параметром."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "Форма packed прямого вызова __fast не соответствует представлению вызываемой функции."

msgid "A direct __fast call packed shape rank does not match."
msgstr "Число измерений формы packed прямого вызова __fast не совпадает."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Динамический размер измерения формы __fast должен ссылаться на параметр типа int или long."

msgid "A function return type cannot have a shape."
msgstr "Возвращаемый тип функции не может иметь форму."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Локальная переменная внутри func __fast должна иметь точный примитивный тип."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Многомерный индекс требует непосредственно именованный параметр с формой."

msgid "A non-void __fast func must return a value."
msgstr "func __fast с типом, отличным от void, должна возвращать значение."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Примитивный параметр __fast не может иметь форму."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Примитивный параметр __fast должен иметь строго тип int, long, float или double."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Ограниченный параметр packed в __fast требует точную форму."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Ограниченный тип packed допустим только для параметра."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Параметр __fast с формой должен иметь тип Packed."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Трансцендентная встроенная функция __fast требует тип float или double."

msgid "A typed function must return a value."
msgstr "Типизированная функция должна возвращать значение."

msgid "A void function cannot return a value."
msgstr "Функция void не может возвращать значение."

msgid "Accelerator Packed argument is missing."
msgstr "Отсутствует аргумент Packed ускорителя."

msgid "Accelerator Packed element type does not match."
msgstr "Тип элемента Packed ускорителя не совпадает."

msgid "Accelerator VM and environment do not match."
msgstr "VM ускорителя и среда не совпадают."

msgid "Accelerator access has an invalid effect."
msgstr "Доступ ускорителя имеет недопустимый эффект."

msgid "Accelerator access has no buffer binding."
msgstr "Доступ ускорителя не имеет привязки буфера."

msgid "Accelerator access references an unknown buffer."
msgstr "Доступ ускорителя ссылается на неизвестный буфер."

msgid "Accelerator argument count changed."
msgstr "Количество аргументов ускорителя изменилось."

msgid "Accelerator argument count is too large."
msgstr "Количество аргументов ускорителя слишком велико."

msgid "Accelerator backend failed to prepare a program."
msgstr "Бэкенду ускорителя не удалось подготовить программу."

msgid "Accelerator backend returned no program."
msgstr "Бэкенд ускорителя не вернул программу."

msgid "Accelerator buffer access is out of range."
msgstr "Доступ к буферу ускорителя вне диапазона."

msgid "Accelerator buffer has no required range."
msgstr "Буфер ускорителя не имеет требуемого диапазона."

msgid "Accelerator buffer has no runtime argument slot."
msgstr "Буфер ускорителя не имеет слота аргумента среды выполнения."

msgid "Accelerator buffer range overflowed."
msgstr "Произошло переполнение диапазона буфера ускорителя."

msgid "Accelerator buffer size overflowed."
msgstr "Произошло переполнение размера буфера ускорителя."

msgid "Accelerator context is unavailable."
msgstr "Контекст ускорителя недоступен."

msgid "Accelerator context reference limit reached."
msgstr "Достигнут предел ссылок на контекст ускорителя."

msgid "Accelerator device buffer is read before definition."
msgstr "Буфер устройства ускорителя читается до определения."

msgid "Accelerator device buffer size is not positive."
msgstr "Размер буфера устройства ускорителя не является положительным."

msgid "Accelerator device buffer size is too large."
msgstr "Размер буфера устройства ускорителя слишком велик."

msgid "Accelerator device buffer size overflowed."
msgstr "Произошло переполнение размера буфера устройства ускорителя."

msgid "Accelerator device-list visitor failed."
msgstr "Сбой посетителя списка устройств ускорителя."

msgid "Accelerator dispatch range is too large."
msgstr "Диапазон диспетчеризации ускорителя слишком велик."

msgid "Accelerator function is not registered in the HIR table."
msgstr "Функция ускорителя не зарегистрирована в таблице HIR."

msgid "Accelerator load has no buffer binding."
msgstr "Загрузка ускорителя не имеет привязки буфера."

msgid "Accelerator local name collision."
msgstr "Конфликт имён локальных переменных ускорителя."

msgid "Accelerator local name is too long."
msgstr "Имя локальной переменной ускорителя слишком длинное."

msgid "Accelerator loop start overflowed."
msgstr "Произошло переполнение начала цикла ускорителя."

msgid "Accelerator output argument is missing."
msgstr "Отсутствует аргумент вывода ускорителя."

msgid "Accelerator output size changed."
msgstr "Размер вывода ускорителя изменился."

msgid "Accelerator output snapshot is missing."
msgstr "Отсутствует снимок вывода ускорителя."

msgid "Accelerator output type changed."
msgstr "Тип вывода ускорителя изменился."

msgid "Accelerator plan does not match live HIR."
msgstr "План ускорителя не соответствует активному HIR."

msgid "Accelerator program validation failed."
msgstr "Сбой проверки программы ускорителя."

msgid "Accelerator reduction has no result entry."
msgstr "Редукция ускорителя не имеет записи результата."

msgid "Accelerator scalar argument is missing."
msgstr "Отсутствует скалярный аргумент ускорителя."

msgid "Accelerator scalar metadata is too large."
msgstr "Скалярные метаданные ускорителя слишком велики."

msgid "Accelerator scalar result argument is missing."
msgstr "Отсутствует аргумент скалярного результата ускорителя."

msgid "Accelerator scalar result has no local."
msgstr "Скалярный результат ускорителя не имеет локальной переменной."

msgid "Accelerator scalar result identity changed."
msgstr "Идентификатор скалярного результата ускорителя изменился."

msgid "Accelerator scalar result is not available."
msgstr "Скалярный результат ускорителя недоступен."

msgid "Accelerator scalar result metadata is missing."
msgstr "Отсутствуют метаданные скалярного результата ускорителя."

msgid "Accelerator scalar result metadata is too large."
msgstr "Метаданные скалярного результата ускорителя слишком велики."

msgid "Accelerator store has no buffer binding."
msgstr "Запись ускорителя не имеет привязки буфера."

msgid "Accelerator trip count overflowed."
msgstr "Произошло переполнение количества итераций ускорителя."

msgid "Adding file %s.\n"
msgstr "Добавление файла %s.\n"

msgid "An accelerator is already attached to this VM."
msgstr "К этой VM уже подключён ускоритель."

msgid "An active Vulkan buffer has no storage."
msgstr "Активный буфер Vulkan не имеет хранилища."

msgid "An inactive Vulkan buffer requested a transfer."
msgstr "Неактивный буфер Vulkan запросил передачу."

msgid "Application container cannot be used as a module: %s"
msgstr "Контейнер приложения нельзя использовать как модуль: %s"

msgid "Application contains an unreachable module."
msgstr "Приложение содержит недостижимый модуль."

msgid "Application output %s collides with input %s.\n"
msgstr "Вывод приложения %s конфликтует с вводом %s.\n"

msgid "Argument (%d: %s) is not a dictionary."
msgstr "Аргумент (%d: %s) не является словарем."

msgid "Argument (%d: %s) is not a double."
msgstr "Аргумент (%d: %s) не является double."

msgid "Argument (%d: %s) is not a float."
msgstr "Аргумент (%d: %s) не является числом с плавающей точкой."

msgid "Argument (%d: %s) is not a function."
msgstr "Аргумент (%d: %s) не является функцией."

msgid "Argument (%d: %s) is not a long."
msgstr "Аргумент (%d: %s) не является long."

msgid "Argument (%d: %s) is not a packed of type %s."
msgstr "Аргумент (%d: %s) не является packed типа %s."

msgid "Argument (%d: %s) is not a packed."
msgstr "Аргумент (%d: %s) не является packed."

msgid "Argument (%d: %s) is not a string."
msgstr "Аргумент (%d: %s) не является строкой."

msgid "Argument (%d: %s) is not an array."
msgstr "Аргумент (%d: %s) не является массивом."

msgid "Argument (%d: %s) is not an int."
msgstr "Аргумент (%d: %s) не является целым числом."

msgid "Argument (%d: %s) is not an integer."
msgstr "Аргумент (%d: %s) не является целым числом."

msgid "Array index %ld is out-of-range."
msgstr "Индекс массива %ld вне диапазона."

msgid "BeUI is not open."
msgstr "BeUI не открыт."

msgid "BeUI.destroyImage received an invalid handle."
msgstr "BeUI.destroyImage получил недопустимый дескриптор."

msgid "BeUI.drawImage failed."
msgstr "Сбой BeUI.drawImage."

msgid "BeUI.drawImagePattern failed."
msgstr "Сбой BeUI.drawImagePattern."

msgid "BeUI.drawImagePattern received an invalid argument."
msgstr "BeUI.drawImagePattern получил недопустимый аргумент."

msgid "BeUI.drawImageRegion failed."
msgstr "Сбой BeUI.drawImageRegion."

msgid "BeUI.drawText failed."
msgstr "Сбой BeUI.drawText."

msgid "BeUI.drawText received an invalid argument."
msgstr "BeUI.drawText получил недопустимый аргумент."

msgid "BeUI.fill failed."
msgstr "Сбой BeUI.fill."

msgid "BeUI.fill received an invalid argument."
msgstr "BeUI.fill получил недопустимый аргумент."

msgid "BeUI.flush failed."
msgstr "Сбой BeUI.flush."

msgid "BeUI.getImageHeight received an invalid handle."
msgstr "BeUI.getImageHeight получил недопустимый дескриптор."

msgid "BeUI.getImageWidth received an invalid handle."
msgstr "BeUI.getImageWidth получил недопустимый дескриптор."

msgid "BeUI.getMilliseconds is unavailable."
msgstr "BeUI.getMilliseconds недоступен."

msgid "BeUI.initWithHint expects 8 or 24 bits per pixel."
msgstr "BeUI.initWithHint ожидает 8 или 24 бита на пиксель."

msgid "BeUI.isKeyDown received an invalid argument."
msgstr "BeUI.isKeyDown получил недопустимый аргумент."

msgid "BeUI.line failed."
msgstr "Сбой BeUI.line."

msgid "BeUI.line received an invalid argument."
msgstr "BeUI.line получил недопустимый аргумент."

msgid "BeUI.loadImage expects a byte array."
msgstr "BeUI.loadImage ожидает массив байтов."

msgid "BeUI.loadImage received an unsupported image."
msgstr "BeUI.loadImage получил неподдерживаемое изображение."

msgid "BeUI.patternFill failed."
msgstr "Сбой BeUI.patternFill."

msgid "BeUI.patternFill received an invalid argument."
msgstr "BeUI.patternFill получил недопустимый аргумент."

msgid "BeUI.sleep is unavailable."
msgstr "BeUI.sleep недоступен."

msgid "BeUI.sleep received an invalid argument."
msgstr "BeUI.sleep получил недопустимый аргумент."

msgid "Branch target not found."
msgstr "Цель перехода не найдена."

msgid "Branch target too far."
msgstr "Цель перехода слишком далеко."

msgid "Broken bytecode."
msgstr "Повреждённый байткод."

msgid "Bytecode input is not recompiled: %s"
msgstr "Входной байткод не перекомпилируется: %s"

msgid "Bytecode input is not recompiled: %s\n"
msgstr "Входной байткод не перекомпилируется: %s\n"

msgid "Bytecode is too large."
msgstr "Байткод слишком велик."

msgid "Bytecode module is too large: %s"
msgstr "Модуль байткода слишком велик: %s"

msgid "Bytecode program is too large.\n"
msgstr "Программа байткода слишком велика.\n"

msgid "Call to non-fast function '%s' is not allowed inside __fast func."
msgstr "Вызов функции '%s', не являющейся __fast, запрещён внутри func __fast."

msgid "Cannot accept a connection."
msgstr "Не удаётся принять соединение."

msgid "Cannot allocate application output path.\n"
msgstr "Не удаётся выделить путь вывода приложения.\n"

msgid "Cannot allocate bytecode output paths.\n"
msgstr "Не удаётся выделить пути вывода байткода.\n"

msgid "Cannot allocate output path for %s.\n"
msgstr "Не удаётся выделить путь вывода для %s.\n"

msgid "Cannot assign to 'let' variable '%s'."
msgstr "Нельзя присвоить значение переменной 'let' '%s'."

msgid "Cannot assign to constant \"%s\"."
msgstr "Нельзя присвоить значение константе \"%s\"."

msgid "Cannot bind to %s:%d. (%s)"
msgstr "Не удаётся выполнить привязку к %s:%d. (%s)"

msgid "Cannot change the socket mode."
msgstr "Не удаётся изменить режим сокета."

msgid "Cannot close file %s."
msgstr "Не удаётся закрыть файл %s."

msgid "Cannot collect bytecode link names from %s."
