msgid "Accelerator load has no buffer binding."
msgstr "La carga del acelerador no tiene vinculación de búfer."

msgid "Accelerator local name collision."
msgstr "Colisión de nombres de variables locales del acelerador."

msgid "Accelerator local name is too long."
msgstr "El nombre de la variable local del acelerador es demasiado largo."

msgid "Accelerator loop start overflowed."
msgstr "Se produjo un desbordamiento del inicio del bucle del acelerador."

msgid "Accelerator output argument is missing."
msgstr "Falta el argumento de salida del acelerador."

msgid "Accelerator output size changed."
msgstr "El tamaño de la salida del acelerador ha cambiado."

