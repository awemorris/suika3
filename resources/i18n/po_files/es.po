msgstr "Acelerador %s %s."

msgid "%s accelerator %s: %s"
msgstr "Acelerador %s %s: %s"

msgid "%s accelerator context is detached."
msgstr "El contexto del acelerador %s está desconectado."

msgid "%s accelerator program changed during begin."
msgstr "El programa del acelerador %s cambió durante el inicio."

msgid "%s accelerator program is not published."
msgstr "El programa del acelerador %s no está publicado."

msgid "%s accelerator session changed during dispatch."
msgstr "La sesión del acelerador %s cambió durante el despacho."

msgid "%s accelerator session changed during finish."
msgstr "La sesión del acelerador %s cambió durante la finalización."

msgid "%s accelerator session changed while publishing results."
msgstr "La sesión del acelerador %s cambió mientras se publicaban los resultados."

msgid "%s failed."
msgstr "%s falló."

msgid "%s is unavailable."
msgstr "%s no está disponible."

msgid "%s() is not defined\n"
msgstr "%s() no está definida\n"

msgid "%s() must have zero or one parameter\n"
msgstr "%s() debe tener cero o un parámetro\n"

msgid "%s(): Function arguments not match."
msgstr "%s(): Los argumentos de la función no coinciden."

msgid "%s(): argument type mismatch (expected %s)."
msgstr "%s(): el tipo del argumento no coincide (se esperaba %s)."

msgid "%s(): local type mismatch (expected %s)."
msgstr "%s(): el tipo de la variable local no coincide (se esperaba %s)."

msgid "%s(): return type mismatch (expected %s)."
msgstr "%s(): el tipo de retorno no coincide (se esperaba %s)."

msgid "%s: Out of memory while parsing."
msgstr "%s: No hay suficiente memoria."

msgid "%s:%d: Error: %s\n"
msgstr "%s:%d: Error: %s\n"

msgid "--gpu-list may be specified only once.\n"
msgstr "--gpu-list solo puede especificarse una vez.\n"

msgid "--gpu-list must be used by itself.\n"
msgstr "--gpu-list debe usarse por sí sola.\n"

msgid "A __fast array index must be int or long."
msgstr "Un índice de array __fast debe ser int o long."

msgid "A __fast assignment requires an exact type match."
msgstr "Una asignación __fast requiere una coincidencia exacta de tipos."

msgid "A __fast assignment target must be a typed local."
msgstr "El destino de una asignación __fast debe ser una variable local con tipo."

msgid "A __fast binary intrinsic requires operands of the same type."
msgstr "Una función intrínseca binaria __fast requiere operandos del mismo tipo."

msgid "A __fast binary operation requires equal primitive operand types."
msgstr "Una operación binaria __fast requiere tipos primitivos de operandos iguales."

msgid "A __fast condition must have type int."
msgstr "Una condición __fast debe tener el tipo int."

msgid "A __fast expression is too deeply nested."
msgstr "Una expresión __fast está anidada a demasiada profundidad."

msgid "A __fast func may call only a direct __fast function or intrinsic."
msgstr "Una func __fast solo puede llamar directamente a una función __fast o una función intrínseca."

msgid "A __fast func must declare its return type."
msgstr "Una func __fast debe declarar su tipo de retorno."

msgid "A __fast func parameter must be primitive or shaped rpacked."
msgstr "Un parámetro de func __fast debe ser primitivo o un rpacked con forma."

msgid "A __fast func return type must be void, int, long, float, or double."
msgstr "El tipo de retorno de una func __fast debe ser void, int, long, float o double."

msgid "A __fast func supports only ranged for loops."
msgstr "Una func __fast solo admite bucles for con rango."

msgid "A __fast function name conflicts with a compiler intrinsic."
msgstr "El nombre de una función __fast entra en conflicto con una función intrínseca del compilador."

msgid "A __fast integer operation requires int or long."
msgstr "Una operación entera __fast requiere int o long."

msgid "A __fast intrinsic requires a statically typed numeric argument."
msgstr "Una función intrínseca __fast requiere un argumento numérico con tipo estático."

msgid "A __fast logical operand must have type int."
msgstr "Un operando lógico __fast debe tener el tipo int."

msgid "A __fast numeric intrinsic requires numeric arguments."
msgstr "Una función intrínseca numérica __fast requiere argumentos numéricos."

msgid "A __fast packed access is provably out of bounds."
msgstr "Se puede demostrar que un acceso packed __fast está fuera de los límites."

msgid "A __fast packed store requires an exact element type match."
msgstr "Un almacenamiento packed __fast requiere una coincidencia exacta del tipo de elemento."

msgid "A __fast parameter shape has more than 8 dimensions."
msgstr "La forma de un parámetro __fast tiene más de 8 dimensiones."

msgid "A __fast ranged loop requires matching int or long bounds."
msgstr "Un bucle con rango __fast requiere límites int o long coincidentes."

msgid "A __fast return value does not match its declared type."
msgstr "Un valor de retorno __fast no coincide con su tipo declarado."

msgid "A __fast shape extent must be int or long."
msgstr "La extensión de una forma __fast debe ser int o long."

msgid "A __fast shape extent must be positive."
msgstr "La extensión de una forma __fast debe ser positiva."

msgid "A __fast subscript base must be a shaped rpacked parameter."
msgstr "La base de un subíndice __fast debe ser un parámetro rpacked con forma."

msgid "A __fast transcendental intrinsic requires float or double."
msgstr "Una función intrínseca trascendental __fast requiere float o double."

msgid "A __fast unary operand must be primitive."
msgstr "Un operando unario __fast debe ser primitivo."

msgid "A binary __fast intrinsic requires operands of the same type."
msgstr "Una función intrínseca binaria __fast requiere operandos del mismo tipo."

msgid "A direct __fast call argument does not match the callee type."
msgstr "Un argumento de una llamada directa __fast no coincide con el tipo de la función llamada."

msgid "A direct __fast call has the wrong argument count."
msgstr "Una llamada directa __fast tiene una cantidad incorrecta de argumentos."

msgid "A direct __fast call packed argument has the wrong element type."
msgstr "Un argumento packed de una llamada directa __fast tiene un tipo de elemento incorrecto."

msgid "A direct __fast call packed argument must be a parameter."
msgstr "Un argumento packed de una llamada directa __fast debe ser un parámetro."

msgid "A direct __fast call packed shape does not match the callee view."
msgstr "La forma packed de una llamada directa __fast no coincide con la vista de la función llamada."

msgid "A direct __fast call packed shape rank does not match."
msgstr "El número de dimensiones de la forma packed de una llamada directa __fast no coincide."

msgid "A dynamic __fast shape extent must name an int or long parameter."
msgstr "Una extensión dinámica de forma __fast debe nombrar un parámetro int o long."

msgid "A function return type cannot have a shape."
msgstr "El tipo de retorno de una función no puede tener forma."

msgid "A local used inside __fast func must have an exact primitive type."
msgstr "Una variable local usada dentro de una func __fast debe tener un tipo primitivo exacto."

msgid "A multi-dimensional subscript requires a directly named shaped parameter."
msgstr "Un subíndice multidimensional requiere un parámetro con forma nombrado directamente."

msgid "A non-void __fast func must return a value."
msgstr "Una func __fast que no sea void debe devolver un valor."

msgid "A primitive __fast parameter cannot have a shape."
msgstr "Un parámetro primitivo __fast no puede tener forma."

msgid "A primitive __fast parameter must use int, long, float, or double exactly."
msgstr "Un parámetro primitivo __fast debe usar exactamente int, long, float o double."

msgid "A restricted packed __fast parameter requires an exact shape."
msgstr "Un parámetro packed restringido __fast requiere una forma exacta."

msgid "A restricted packed type is only valid for a parameter."
msgstr "Un tipo packed restringido solo es válido para un parámetro."

msgid "A shaped __fast parameter must be a Packed type."
msgstr "Un parámetro __fast con forma debe ser de tipo Packed."

msgid "A transcendental __fast intrinsic requires float or double."
msgstr "Una función intrínseca trascendental __fast requiere float o double."

msgid "A typed function must return a value."
msgstr "Una función con tipo debe devolver un valor."

msgid "A void function cannot return a value."
msgstr "Una función void no puede devolver un valor."

msgid "Accelerator Packed argument is missing."
msgstr "Falta el argumento Packed del acelerador."

msgid "Accelerator Packed element type does not match."
msgstr "El tipo de elemento Packed del acelerador no coincide."

msgid "Accelerator VM and environment do not match."
msgstr "La VM del acelerador y el entorno no coinciden."

msgid "Accelerator access has an invalid effect."
msgstr "El acceso del acelerador tiene un efecto no válido."

msgid "Accelerator access has no buffer binding."
msgstr "El acceso del acelerador no tiene vinculación de búfer."

msgid "Accelerator access references an unknown buffer."
msgstr "El acceso del acelerador hace referencia a un búfer desconocido."

msgid "Accelerator argument count changed."
msgstr "La cantidad de argumentos del acelerador ha cambiado."

msgid "Accelerator argument count is too large."
msgstr "La cantidad de argumentos del acelerador es demasiado grande."

msgid "Accelerator backend failed to prepare a program."
msgstr "El backend del acelerador no pudo preparar un programa."

msgid "Accelerator backend returned no program."
msgstr "El backend del acelerador no devolvió ningún programa."

msgid "Accelerator buffer access is out of range."
msgstr "El acceso al búfer del acelerador está fuera de rango."

msgid "Accelerator buffer has no required range."
msgstr "El búfer del acelerador no tiene el rango requerido."

msgid "Accelerator buffer has no runtime argument slot."
msgstr "El búfer del acelerador no tiene una ranura de argumento del entorno de ejecución."

msgid "Accelerator buffer range overflowed."
msgstr "Se produjo un desbordamiento del rango del búfer del acelerador."

msgid "Accelerator buffer size overflowed."
msgstr "Se produjo un desbordamiento del tamaño del búfer del acelerador."

msgid "Accelerator context is unavailable."
msgstr "El contexto del acelerador no está disponible."

msgid "Accelerator context reference limit reached."
msgstr "Se alcanzó el límite de referencias del contexto del acelerador."

msgid "Accelerator device buffer is read before definition."
msgstr "El búfer del dispositivo del acelerador se lee antes de su definición."

msgid "Accelerator device buffer size is not positive."
msgstr "El tamaño del búfer del dispositivo del acelerador no es positivo."

msgid "Accelerator device buffer size is too large."
msgstr "El tamaño del búfer del dispositivo del acelerador es demasiado grande."

msgid "Accelerator device buffer size overflowed."
msgstr "Se produjo un desbordamiento del tamaño del búfer del dispositivo del acelerador."

msgid "Accelerator device-list visitor failed."
msgstr "El visitante de la lista de dispositivos del acelerador falló."

msgid "Accelerator dispatch range is too large."
