msgstr "Falta la instantánea de salida del acelerador."

msgid "Accelerator output type changed."
msgstr "El tipo de salida del acelerador ha cambiado."

msgid "Accelerator plan does not match live HIR."
msgstr "El plan del acelerador no coincide con el HIR activo."

msgid "Accelerator program validation failed."
msgstr "La validación del programa del acelerador falló."

msgid "Accelerator reduction has no result entry."
msgstr "La reducción del acelerador no tiene una entrada de resultado."

msgid "Accelerator scalar argument is missing."
msgstr "Falta el argumento escalar del acelerador."

