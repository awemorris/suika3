set(CMAKE_SYSTEM_NAME DOS)
set(CMAKE_SYSTEM_PROCESSOR i386)

find_program(NOCT_OPENWATCOM_C_COMPILER
    NAMES wcl386
    HINTS
        "$ENV{WATCOM}/binl"
        "$ENV{HOME}/opt/openwatcom-1.9/binl"
    REQUIRED)
get_filename_component(NOCT_OPENWATCOM_BIN_DIR
    "${NOCT_OPENWATCOM_C_COMPILER}" DIRECTORY)
get_filename_component(NOCT_OPENWATCOM_ROOT
    "${NOCT_OPENWATCOM_BIN_DIR}" DIRECTORY)
set(ENV{WATCOM} "${NOCT_OPENWATCOM_ROOT}")
set(ENV{INCLUDE} "${NOCT_OPENWATCOM_ROOT}/h")
set(ENV{PATH} "${NOCT_OPENWATCOM_BIN_DIR}:$ENV{PATH}")

set(CMAKE_C_COMPILER "${NOCT_OPENWATCOM_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${NOCT_OPENWATCOM_C_COMPILER}")

set(CMAKE_C_COMPILER_TARGET dos)
set(CMAKE_CXX_COMPILER_TARGET dos)

set(CMAKE_C_FLAGS_INIT "-bt=dos -ox -oe=200 -zp4 -fpi87")

set(CMAKE_EXE_LINKER_FLAGS
    "system dos4g option stack=65536 library clib3r library math387r"
    CACHE STRING "" FORCE)

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_STATIC_LIBRARY_SUFFIX ".lib" CACHE STRING "" FORCE)
